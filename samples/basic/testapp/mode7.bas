' Screen mode 7: text (25 rows) + a 320x200 bitmap, 1 byte per pixel (256-color palette).
' The BASIC version of samples/ruby/mode7.rb. First it checks the drawing with BmPGet / BmRead, then shows a demo:
' the palette swatches, lines, a plasma and a rotating palette. q ends it; it also ends after about 10 seconds.
' Generated by scripts/make_testapp_bas.py (2026-11-01).
DEFDBL A-Z
Machine.Mode = 7
NG = 0
SUB CHECK(BYVAL WHAT$, BYVAL GOT$, BYVAL WANT$)
    IF GOT$ <> WANT$ THEN PRINT "NG "; WHAT$; ": got "; GOT$; ", want "; WANT$: NG = NG + 1
END SUB
FUNCTION NS(BYVAL V) AS STRING
    NSX$ = STR$(V)
    IF LEFT$(NSX$, 1) = " " THEN NSX$ = MID$(NSX$, 2)
    NS = NSX$
END FUNCTION
CHECK "size", NS(Machine.BmWidth) + "x" + NS(Machine.BmHeight), "320x200"
CHECK "text rows", NS(Machine.TextRows), "25"
Machine.BmClear 0
CHECK "clear", NS(Machine.BmPGet(319, 199)), "0"
Machine.BmPSet 10, 20, 200
CHECK "pset", NS(Machine.BmPGet(10, 20)), "200"
CHECK "pget outside", NS(Machine.BmPGet(320, 0)), "-1"
Machine.BmFillRect 100, 50, 8, 4, 77
CHECK "fill_rect inside", NS(Machine.BmPGet(107, 53)), "77"
CHECK "fill_rect edge", NS(Machine.BmPGet(108, 53)), "0"
Machine.BmFillRect -5, -5, 10, 10, 5           ' clipped at the top-left corner
CHECK "fill_rect clip", NS(Machine.BmPGet(0, 0)) + "," + NS(Machine.BmPGet(4, 4)) + "," + NS(Machine.BmPGet(5, 5)), "5,5,0"
Machine.BmLine 0, 199, 319, 0, 9
CHECK "line ends", NS(Machine.BmPGet(0, 199)) + "," + NS(Machine.BmPGet(319, 0)), "9,9"
Machine.BmRect 200, 100, 20, 10, 33
CHECK "rect", NS(Machine.BmPGet(200, 100)) + "," + NS(Machine.BmPGet(219, 109)) + "," + NS(Machine.BmPGet(210, 105)), "33,33,0"
CHECK "write", NS(Machine.BmWrite(320 * 150 + 10, CHR$(1) + CHR$(2) + CHR$(3))), "3"
R$ = Machine.BmRead(320 * 150 + 10, 3)
CHECK "read", NS(ASC(MID$(R$, 1, 1))) + "," + NS(ASC(MID$(R$, 2, 1))) + "," + NS(ASC(MID$(R$, 3, 1))), "1,2,3"
CHECK "write at the end", NS(Machine.BmWrite(63999, CHR$(7) + CHR$(8))), "1"
Machine.BmPalette 250, 255, 0, 0
IF NG = 0 THEN PRINT "mode7 checks: all ok" ELSE PRINT "mode7 checks:"; NG; "NG"

' ---- demo ----
Machine.BmClear 0
FOR R = 0 TO 15: FOR C = 0 TO 15: Machine.BmFillRect C * 8, R * 6, 8, 6, R * 16 + C: NEXT C: NEXT R   ' the 256 colors as 16x16 swatches
' a plasma on the right that uses colors 16..231 (the 6x6x6 cube), drawn a row at a time with BmWrite
FOR Y = 0 TO 95
    ROW$ = ""
    FOR X = 0 TO 191
        V = X * 3 + Y * 5 + INT(X * Y / 40)
        ROW$ = ROW$ + CHR$(16 + V - INT(V / 216) * 216)
        IF LEN(ROW$) = 192 THEN DUMMY = Machine.BmWrite(Y * 320 + 128, ROW$)
    NEXT X
NEXT Y
FOR K = 0 TO 19: Machine.BmLine 0, 100 + K * 5, 319, 199 - K * 5, 232 + K: NEXT K
Machine.TextClear
Machine.TextPut 0, 0, "SCREEN MODE 7  320x200x8 + text 80x25", Machine.TAttr(15, 1)
Machine.TextPut 0, 24, "q: quit   (the bottom text row is row 24)", Machine.TAttr(14)
T0 = Machine.Ms
F = 0
QUIT = 0
WHILE NOT QUIT
    IF Machine.Key = 113 OR Machine.Ms - T0 > 10000 THEN QUIT = -1
    Machine.VSync
    F = F + 1
    ' turn the plasma colors (16..231) round: 216 palette writes a frame
    FOR I = 0 TO 215
        C = I + F: C = C - INT(C / 216) * 216
        Machine.BmPalette 16 + I, (C * 7) MOD 256, (C * 3) MOD 256, 255 - (C * 5) MOD 256
    NEXT I
WEND
Machine.TextClear
PRINT "MODE7 done"
