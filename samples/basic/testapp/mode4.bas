DATA 32, 32, -1, 80, 83, 3, 65, 82, 3, 73, 73, 3, 82, 65, 3, 83, 80, 3, 32, 32, -1, 32, 32, -1
FOR M = 0 TO 5: FOR P = 0 TO 23: READ MSGC(M, P), MSGM(M, P), MSGW(M, P): NEXT P: NEXT M
SUB BUILDMAP
    FOR TY = 0 TO 63
        MI = TY MOD 6: PAL = TY MOD 4
        FOR TX = 0 TO 63
            P = (TX + TY) MOD 24
            IF MSGW(MI, P) < 0 THEN K = 0 ELSE K = (MSGW(MI, P) + TY) MOD 4
            IF K = 1 THEN Machine.LrMap 1, TX, TY, MSGM(MI, P), PAL, -1, 0 ELSE Machine.LrMap 1, TX, TY, MSGC(MI, P), PAL, 0, K = 3
        NEXT TX
    NEXT TY
    BUILDBG0
END SUB
SUB BUILDFONTTABLE                      ' the 16x16 font table on BG1 (no flip, no scroll)
    Machine.LrFillMap 1, 32
    FOR N = 0 TO 15: H = ASC(MID$("0123456789ABCDEF", N + 1, 1)): Machine.LrMap 1, 3 + N * 2, 1, H, 1: Machine.LrMap 1, 1, 3 + N, H, 1: NEXT N
    FOR R = 0 TO 15: FOR C = 0 TO 15: Machine.LrMap 1, 3 + C * 2, 3 + R, R * 16 + C, 0: NEXT C: NEXT R
END SUB
OBJDEMO = 0: OBJCOUNT = 24              ' 0 = no objects, 1 = demo, 2 = load test
SUB SETUPOBJECTS(BYVAL HEAVY)
    IF HEAVY THEN N = 128 ELSE N = OBJCOUNT
    FOR I = 0 TO 127
        IF I >= N THEN Machine.LrObjHide I ELSE IF HEAVY THEN K = 3 ELSE K = I MOD 4
        IF I < N THEN W = 8 * 2 ^ K: Machine.LrObj I, 0, 0, SPR(K), W, W, 1 + I MOD 5, I MOD 3
        IF I < N AND HEAVY THEN Machine.LrObjMove I, 96 + (I MOD 8) * 4, 72 + (INT(I / 8) MOD 8) * 4   ' the load test: 128 x 64x64 on the same place
    NEXT I
    Machine.LrObjVisible -1
    IF HEAVY THEN OBJDEMO = 2 ELSE OBJDEMO = 1
END SUB
POX = 0: POY = 0                        ' the pad moves the centre of the objects
' the speed of the objects (their own motion and the pad's): 1 / ODIV. v cycles 1/4 -> 1/2 -> 1
ODIV = 4: OPH = 0: OLAST = Machine.Ms
FUNCTION SPEEDKEY(BYVAL C)
    SPEEDKEY = 0
    IF C <> 118 THEN EXIT FUNCTION      ' v
    IF ODIV = 1 THEN ODIV = 4 ELSE ODIV = ODIV / 2
    SPEEDKEY = -1
END FUNCTION
SUB PADOBJECTS
    LX = Machine.PadStickX(0, "left"): LY = Machine.PadStickY(0, "left")
    IF LX <> 0 THEN VX = LX * 4 / ODIV ELSE VX = Machine.PadDirX(0) * 3 / ODIV
    IF LY <> 0 THEN VY = LY * 4 / ODIV ELSE VY = Machine.PadDirY(0) * 3 / ODIV
    POX = CLAMP(POX + VX, -150, 150): POY = CLAMP(POY + VY, -110, 110)
    IF Machine.PadPressed(0, Machine.PAD_A) THEN POX = 0: POY = 0   ' A: back to the middle
END SUB
SUB MOVEOBJECTS(BYVAL PH)
    OX = FIX(POX): OY = FIX(POY)
    FOR I = 0 TO OBJCOUNT - 1
        W = 8 * 2 ^ (I MOD 4)
        ' the phase stays fractional and SINT is interpolated (at 1/4 speed the objects still move every frame)
        A = PH * (1 + (I AND 3)) / 2 + I * 5
        B = PH * (1 + (INT(I / 4) AND 3)) / 3 + I * 11
        AI = INT(A): AF = A - AI: AI = AI - INT(AI / 64) * 64
        BI = INT(B): BF = B - BI: BI = BI - INT(BI / 64) * 64
        SA = SINT(AI) + (SINT(AI + 1) - SINT(AI)) * AF
        SB = SINT(BI) + (SINT(BI + 1) - SINT(BI)) * BF
        Machine.LrObjMove I, INT(160 - W / 2 + OX + SA * 140 / 127 + 0.5), INT(120 - W / 2 + OY + SB * 100 / 127 + 0.5)
    NEXT I
END SUB
' the timing and the mode at the top left, on BG0. BG0 scrolls sideways, so the label is written
' from the leftmost visible column again whenever it moves. The lines are LBL$(0..LBLN-1)
LABELROW = 1
PADLABROW = 6                           ' mode 6: the pad under the label
DIM LBL$(7)
LBLN = 0
SUB LABELUPDATE(BYVAL ROW)
    COL = (INT(SX0 / 8) + 1) AND 63
    K$ = ""
    FOR LI = 0 TO LBLN - 1: K$ = K$ + LBL$(LI) + CHR$(10): NEXT LI
    IF LABC(ROW) = COL AND LABK$(ROW) = K$ THEN EXIT SUB
    FOR LI = 0 TO LBLN - 1
        GRIDROW ROW + LI
        L$ = LEFT$(LBL$(LI), 31)
        FOR LJI = 1 TO LEN(L$): Machine.LrMap 0, (COL + LJI - 1) AND 63, ROW + LI, ASC(MID$(L$, LJI, 1)), 0: NEXT LJI
    NEXT LI
    LABC(ROW) = COL: LABK$(ROW) = K$
END SUB
SUB SHOWBG
    Machine.LrBgVisible 0, LRON AND (BG AND 1) <> 0 AND NOT TABLE
    Machine.LrBgVisible 1, LRON AND (BG AND 2) <> 0
END SUB
SUB LOWRESINIT(BYVAL LIGHT)
    Machine.LrBgVisible 0, 0: Machine.LrBgVisible 1, 0: Machine.LrObjVisible 0   ' hidden while building
    RAMP 0, 31, 31, 31: RAMP 1, 8, 31, 12: RAMP 2, 31, 22, 6: RAMP 3, 10, 18, 31: RAMP 4, 31, 10, 10   ' white, green, orange, blue, red
    LOADFONT 0
    DISC 256, 64: DISC 320, 32: DISC 336, 16: DISC 340, 8
    BUILDMAP
    LRON = -1: TABLE = 0: SCROLLON = -1: SX0 = 0
    IF LIGHT THEN BG = 1: SHOWBG ELSE BG = 3: SHOWBG: SETUPOBJECTS 0   ' mode 3: BG0 only, no objects (see the note at the top)
END SUB
T0 = Machine.Ms: PH = 0: WPHASE = 0: WAVEON = 0
SUB LOWRESTICK(BYVAL ROWLAB)
    IF SCROLLON AND NOT TABLE THEN PH = INT((Machine.Ms - T0) * 60 / 1000): SX0 = WRAP(512 - INT(PH / 4), 512): Machine.LrScroll 1, WRAP(PH, 512), WRAP(INT(PH / 4), 512): Machine.LrScroll 0, SX0, 0: Machine.LrRasterWave 0, WAVE$, WPHASE: WPHASE = (WPHASE + 1) MOD 255: WAVEON = -1 ELSE IF WAVEON THEN Machine.LrRasterClear: WAVEON = 0
    NOW = Machine.Ms
    OPH = OPH + (NOW - OLAST) * 60 / 1000 / ODIV   ' the objects' own clock: 60 units a second at 1x
    OLAST = NOW
    IF OBJDEMO = 1 THEN PADOBJECTS: MOVEOBJECTS OPH
    IF NOT TABLE THEN SETLABEL: LABELUPDATE LABELROW
END SUB
FUNCTION LOWRESKEY(BYVAL C)             ' the keys of lrdemo_key (l b f F o O S)
    LOWRESKEY = -1
    IF C = 108 THEN LRON = NOT LRON: SHOWBG: Machine.LrObjVisible LRON AND OBJDEMO <> 0: EXIT FUNCTION
    IF C = 98 THEN BG = (BG + 1) MOD 4: SHOWBG: EXIT FUNCTION    ' BG0 only -> BG1 only -> both -> none
    IF C = 102 THEN FONTBOLD = NOT FONTBOLD: LOADFONT FONTBOLD: EXIT FUNCTION
    IF C = 70 THEN TABLE = NOT TABLE: IF TABLE THEN BUILDFONTTABLE: Machine.LrScroll 1, 0, 0: SHOWBG: EXIT FUNCTION ELSE BUILDMAP: SHOWBG: EXIT FUNCTION
    IF C = 111 THEN IF OBJDEMO <> 1 THEN OBJCOUNT = 24: SETUPOBJECTS 0: EXIT FUNCTION ELSE IF OBJCOUNT >= 128 THEN OBJDEMO = 0: Machine.LrObjVisible 0: EXIT FUNCTION ELSE OBJCOUNT = OBJCOUNT * 2: IF OBJCOUNT > 128 THEN OBJCOUNT = 128
    IF C = 111 THEN SETUPOBJECTS 0: EXIT FUNCTION
    IF C = 79 THEN IF OBJDEMO = 2 THEN OBJDEMO = 0: Machine.LrObjVisible 0: EXIT FUNCTION ELSE SETUPOBJECTS -1: EXIT FUNCTION
    IF C = 83 THEN SCROLLON = NOT SCROLLON: T0 = Machine.Ms - PH * 1000 / 60: EXIT FUNCTION
    LOWRESKEY = 0
END FUNCTION

' ---- music (the sample SMF, Sound / SPEC_sound.md) ----
SUB MUSICSTART
    IF Sound.Play("WTF4CH.mid", -1) THEN PRINT "music: WTF4CH.mid ("; Sound.Length / 1000; "s, repeated; m pauses)" ELSE PRINT "music: WTF4CH.mid is not in this folder -- no music"
END SUB
SUB MUSICKEY(BYVAL C)
    IF C <> 109 OR NOT Sound.Playing THEN EXIT SUB    ' m
    IF Sound.Paused THEN Sound.Resume ELSE Sound.Pause
END SUB

' ---- the pad (pad 0): what is pressed now, for the screen ----
DIM PADN(15), PADS$(15)
DATA 1, X, 2, A, 3, B, 4, Y, 5, LB, 6, RB, 7, LT, 8, RT, 9, BACK, 10, START, 11, LS, 12, RS, 29, UP, 30, DOWN, 31, LEFT, 32, RIGHT
FOR I = 0 TO 15: READ PADN(I), PADS$(I): NEXT I
PADON = 0: PADCHK = 0
FUNCTION PADLINE(BYVAL SHORT) AS STRING
    PADCHK = PADCHK + 1
    IF PADCHK MOD 30 = 1 THEN PADON = Machine.Pad(0, "connected")   ' connected? (twice a second)
    IF PADCHK >= 30000 THEN PADCHK = 0
    IF NOT PADON THEN IF SHORT THEN PADLINE = "PAD --": EXIT FUNCTION ELSE PADLINE = "pad 0: not connected (the F310 needs the D switch)": EXIT FUNCTION
    HELD$ = ""
    FOR PI = 0 TO 11: IF Machine.PadButton(0, PADN(PI)) THEN HELD$ = HELD$ + " " + PADS$(PI)
    NEXT PI
    IF LEN(HELD$) > 0 THEN HELD$ = MID$(HELD$, 2)
    IF ODIV = 1 THEN SP$ = "1" ELSE SP$ = "1/" + DS(ODIV)
    DX = Machine.PadDirX(0): DY = Machine.PadDirY(0)
    IF SHORT THEN PADLINE = "PAD " + SG(DX, 0) + " " + SG(DY, 0) + " " + HELD$ + " V" + SP$: EXIT FUNCTION
    S$ = "pad 0: dir " + SG(DX, 0) + " " + SG(DY, 0) + "  left " + F2(Machine.PadStickX(0, "left")) + " " + F2(Machine.PadStickY(0, "left"))
    PADLINE = S$ + "  right " + F2(Machine.PadStickX(0, "right")) + " " + F2(Machine.PadStickY(0, "right")) + "  " + HELD$ + "  (speed " + SP$ + ")"
END FUNCTION
SUB PADEVENTS                           ' mode 0: the presses and releases to the UART log
    IF NOT PADON THEN PADCHK = PADCHK + 1: IF PADCHK MOD 30 = 1 THEN PADON = Machine.Pad(0, "connected")
    IF PADCHK >= 30000 THEN PADCHK = 0
    IF NOT PADON THEN EXIT SUB
    FOR PI = 0 TO 15
        IF Machine.PadPressed(0, PADN(PI)) THEN PRINT "[testapp] pad 0 "; PADS$(PI); " pressed"
        IF Machine.PadReleased(0, PADN(PI)) THEN PRINT "[testapp] pad 0 "; PADS$(PI); " released"
    NEXT PI
END SUB

SUB ONKEY(BYVAL C)
    MUSICKEY C
    KEYECHO C
    IF C = 116 THEN Machine.TextVisible = NOT Machine.TextVisible   ' t
    IF NOT SPEEDKEY(C) THEN DUMMY = LOWRESKEY(C)
END SUB

' ---- main loop ----
MUSICSTART
Machine.TextVisible = -1
TEXTDEMO "m=music t=text pad=move v=speed l=lowres b=BG o=objects O=object S=scroll F=font f=bold q=quit"
FOR P = 0 TO 3: STATUSPAD P: NEXT P
FOR K = 0 TO 3: STATUSMSC K: NEXT K
Machine.TextPut 2, KEYROW, "-- keys " + STRING$(66, "-"), Machine.TAttr(8, 0, TA)
KEYITEM 0, "m", "music pause / resume"
KEYITEM 1, "t", "text plane on / off"
KEYITEM 2, "pad", "move the objects (A: middle)"
KEYITEM 3, "v", "object speed 1/4, 1/2, 1"
KEYITEM 4, "l", "lowres on / off"
KEYITEM 5, "b", "BG planes (0, 1, both, none)"
KEYITEM 6, "o", "objects (24 .. 128, off)"
KEYITEM 7, "O", "object load test"
KEYITEM 8, "S", "scroll on / off"
KEYITEM 9, "F", "font table"
KEYITEM 10, "f", "bold font"
KEYITEM 11, "q", "quit"
DRAWPATTERN
LOWRESINIT 0
QUIT = 0
WHILE NOT QUIT
    C = Machine.Key
    WHILE C >= 0 AND NOT QUIT
        IF C = 113 THEN QUIT = -1 ELSE ONKEY C
        C = Machine.Key
    WEND
    LOWRESTICK 0
    STATUSTICK
    TPUT ROWPADUI, PADLINE(0), 11
    Machine.VSync
WEND
Machine.LrClear
Sound.Stop
PRINT "bye"
