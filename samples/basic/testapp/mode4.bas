DATA 53, 88, 3, 49, 73, 3, 50, 80, 3, 80, 50, 3, 73, 49, 3, 88, 53, 3, 32, 32, -1, 32, 32, -1
DATA 80, 69, 0, 65, 84, 0, 76, 84, 0, 69, 69, 0, 84, 76, 0, 84, 65, 0, 69, 80, 0, 32, 32, -1
