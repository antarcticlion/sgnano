FONTBOLD = 0
SUB LOADFONT(BYVAL BOLD)
    Machine.LrPattern 0, STRING$(64, 128)   ' tile 0: transparent
    FOR CODE = 32 TO 126
        D$ = ""
        FOR Y = 0 TO 7
            R = FONT8(CODE - 32, Y)
            IF BOLD THEN R = R OR INT(R / 2)
            FOR X = 0 TO 7: IF R AND BITV(X) THEN D$ = D$ + CHR$(127) ELSE D$ = D$ + CHR$(128)
            NEXT X
        NEXT Y
        Machine.LrPattern CODE, D$          ' the ink is color 127 (the brightest of the ramp), the rest transparent
    NEXT CODE
END SUB
SUB RAMP(BYVAL PAL, BYVAL R, BYVAL G, BYVAL B)    ' colors 0..127 from dark to bright
    FOR C = 0 TO 127
        Machine.LrPalette PAL, C, INT(INT(R * 255 / 31) * C / 127), INT(INT(G * 255 / 31) * C / 127), INT(INT(B * 255 / 31) * C / 127)
    NEXT C
END SUB
SUB DISC(BYVAL TILE, BYVAL SIZE)        ' bright in the middle, darker to the edge, transparent outside; 2 tiles (128 bytes) a call
    DC = INT(SIZE / 2): RR = DC * DC
    D$ = "": DT = TILE
    FOR DI = 0 TO SIZE * SIZE - 1
        X = (DI MOD SIZE) - DC: Y = INT(DI / SIZE) - DC: DD = X * X + Y * Y
        IF DD >= RR THEN D$ = D$ + CHR$(128) ELSE D$ = D$ + CHR$(127 - INT(DD * 127 / RR))
        IF LEN(D$) = 128 THEN Machine.LrPattern DT, D$: D$ = "": DT = DT + 2
    NEXT DI
    IF LEN(D$) > 0 THEN Machine.LrPattern DT, D$
END SUB
FUNCTION GRIDCODE(BYVAL TX, BYVAL TY)   ' BG0: a grid every 8 tiles
    IF TX MOD 8 = 0 THEN IF TY MOD 8 = 0 THEN GRIDCODE = 43 ELSE GRIDCODE = 124 ELSE IF TY MOD 8 = 0 THEN GRIDCODE = 45 ELSE GRIDCODE = 32
END FUNCTION
SUB GRIDROW(BYVAL TY)                   ' the right half is flipped horizontally, the lower half vertically
    FOR TX = 0 TO 63: Machine.LrMap 0, TX, TY, GRIDCODE(TX, TY), 4, TX >= 32, TY >= 32: NEXT TX
END SUB
DIM LABC(30), LABK$(30)                 ' the label written on each row of BG0: column and text
SUB BUILDBG0
    FOR TY = 0 TO 63: GRIDROW TY: NEXT TY
    FOR I = 0 TO 30: LABC(I) = -1: LABK$(I) = "": NEXT I
END SUB
