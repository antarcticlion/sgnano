END SUB

SUB CLEARROW(CRY)
    Machine.TextPut 0, CRY, SPACE$(80), Machine.TAttr(0, 0, 0)
END SUB

FUNCTION READKEY()
    RK = -1
    WHILE RK < 0
        RK = Machine.Key
        IF RK < 0 THEN Machine.VSync 1
    WEND
    IF RK = 27 OR RK = 113 THEN READKEY = -1: EXIT FUNCTION
    READKEY = RK
END FUNCTION

SUB CLRKEYS
    Machine.ClearKeys
END SUB

SUB BANNER
    CELLFLAGS = C_DW + C_DH + C_LEFT + C_RIGHT + C_OVER + C_UNDER
    CLRKEYS
    Machine.Mode = 1
    Machine.TextClear Machine.TAttr(0, 0, 0)
    PUTTXT 0, 0, "将棋 - コンピュータ対戦", 15, 0, C_BOLD
