SUB DRAWBOARD
    TARGETSQUARES
    SOURCESQUARES
    DBLTO = -1: DBLFR = -1
    IF HASLAST THEN DBLTO = MOVETO(LASTMV): DBLFR = MOVEFROM(LASTMV)
    FOR DBDC = 0 TO 8
        IF HUMAN = 1 THEN DBCH$ = CHR$(105 - DBDC) ELSE DBCH$ = CHR$(97 + DBDC)
        BOARDTXT 23 + DBDC * 4, 2, DBCH$, 0, C_BOLD
    NEXT DBDC
    FOR DBDR = 0 TO 8
        DBY = 3 + DBDR * 2
        IF HUMAN = 1 THEN DBCH$ = CHR$(57 - DBDR) ELSE DBCH$ = CHR$(49 + DBDR)
        DBCH$ = DBCH$ + " "
        BOARDTXT 20, DBY, DBCH$, 0, C_BOLD
        BOARDTXT 59, DBY, DBCH$, 0, C_BOLD
        FOR DBDC = 0 TO 8
            DBP = BOARDCELL(DBDR, DBDC)
            DBX = 23 + DBDC * 4
            DBSQ = BOARDINDEX(DBDR, DBDC)
            DBHI = 0
            IF BOARDACT THEN IF DBDR = CDR AND DBDC = CDC THEN DBHI = 1
            IF BOARDACT AND DBHI = 0 AND TGT(DBSQ) <> 0 THEN DBHI = 2
            IF BOARDACT AND DBHI = 0 AND SRC(DBSQ) <> 0 THEN DBHI = 3
            IF DBHI = 0 AND DBSQ = DBLTO THEN DBHI = 4
            IF DBHI = 0 AND DBSQ = DBLFR THEN DBHI = 4
            DBCB = 14
            IF DBHI = 1 THEN DBCB = 12
            IF DBHI = 2 THEN DBCB = 13
            IF DBHI = 3 THEN DBCB = 15
            IF DBHI = 4 THEN DBCB = 9: IF TURN = HUMAN THEN DBCB = 10
            IF DBP = 0 THEN DBCOL = 0: IF BOARDACT THEN DBCOL = 4: PUTTXT DBX, DBY, "　", DBCOL, DBCB, CELLFLAGS
            IF DBP <> 0 THEN DBCODE = ABS(DBP): DBTYP = KIND(DBCODE): DBGL$ = DISPLAYCH$(DBTYP)
            IF DBP <> 0 AND DBCODE > 8 THEN DBGL$ = PROMOTEDCH$(DBTYP)
            IF DBP < 0 AND DBTYP = KING THEN DBGL$ = "王"
            IF DBP <> 0 THEN DBHUM = 0: IF (DBP > 0 AND HUMAN = 1) OR (DBP < 0 AND HUMAN = -1) THEN DBHUM = -1
            IF DBP <> 0 THEN DBCOL = 2: IF DBHUM THEN DBCOL = 1: IF DBHI = 4 THEN DBCOL = 0
            IF DBP <> 0 THEN DBROT = C_ROT270: IF DBHUM THEN DBROT = C_ROT90
            IF DBP <> 0 THEN PUTTXT DBX, DBY, DBGL$, DBCOL, DBCB, CELLFLAGS + DBROT
        NEXT DBDC
    NEXT DBDR
END SUB

SUB HANDTYPES(HTSIDE)
    HTN = 0
    FOR HTI = 1 TO 7
        IF HVAL(HTSIDE, HTI) > 0 THEN HTYPES(HTN) = HTI: HTN = HTN + 1
    NEXT HTI
END SUB

SUB DRAWPANELS
    FOR DPI = 4 TO 11
        Machine.TextPut 0, DPI, SPACE$(19), Machine.TAttr(0, 0, 0)
        Machine.TextPut 61, DPI, SPACE$(19), Machine.TAttr(0, 0, 0)
    NEXT DPI
    IF HUMAN = 1 THEN DPH$ = "先手" ELSE DPH$ = "後手"
    IF HUMAN = 1 THEN DPA$ = "後手" ELSE DPA$ = "先手"
    PUTTXT 0, 2, "あなた", 9, 0, C_BOLD
    PUTTXT 0, 3, DPH$ + " 持ち駒", 9, 0, 0
    HANDTYPES HUMAN
    IF HTN = 0 THEN PUTTXT 0, 4, "-", 9, 0, 0
    DPI = 0
    WHILE DPI < HTN
        DPT = HTYPES(DPI)
        DP$ = DISPLAYCH$(DPT) + " x" + NUMSTR(HVAL(HUMAN, DPT))
        DPCOL = 9: DPFL = 0: DPBG = 0
        IF FOCUS = 2 AND HANDIDX = DPI THEN DPCOL = 0: DPFL = C_BOLD: DPBG = 12
        IF SELDROP = DPT THEN DPCOL = 0: DPFL = C_BOLD: DPBG = 13
        IF DPBG <> 0 THEN Machine.TextPut 0, 4 + DPI, SPACE$(19), Machine.TAttr(0, DPBG, 0)
        PUTTXT 0, 4 + DPI, DP$, DPCOL, DPBG, DPFL
        DPI = DPI + 1
    WEND
    PUTTXT 61, 2, "AI", 10, 0, C_BOLD
    PUTTXT 61, 3, DPA$ + " 持ち駒", 10, 0, 0
    DPAI = 0
    FOR DPT = 1 TO 7
        IF HVAL(-HUMAN, DPT) > 0 AND DPAI < 8 THEN DP$ = DISPLAYCH$(DPT) + " x" + NUMSTR(HVAL(-HUMAN, DPT)): PUTTXT 61, 4 + DPAI, DP$, 10, 0, 0: DPAI = DPAI + 1
    NEXT DPT
    IF DPAI = 0 THEN PUTTXT 61, 4, "-", 10, 0, 0
END SUB

SUB DRAWPROMHINT
    PUTTXT 0, 25, "成りますか？", 15, 0, C_BOLD
    IF PROMIDX = 0 THEN PUTTXT 14, 25, "[成らない]", 0, 9, C_BOLD ELSE PUTTXT 14, 25, "[成らない]", 12, 0, 0
    IF PROMIDX = 1 THEN PUTTXT 26, 25, "[成る]", 0, 9, C_BOLD ELSE PUTTXT 26, 25, "[成る]", 12, 0, 0
    PUTTXT 0, 26, "←→:選択  Enter:決定  Tab:取消", 12, 0, 0
END SUB

SUB DRAWHINT
    CLEARROW 25: CLEARROW 26
    IF FOCUS = 3 THEN DRAWPROMHINT: EXIT SUB
    PUTTXT 0, 25, "メニュー: ", 12, 0, 0
    IF FOCUS = 1 AND CMDIDX = 0 THEN PUTTXT 10, 25, "[ヘルプ]", 0, 9, C_BOLD ELSE PUTTXT 10, 25, "[ヘルプ]", 12, 0, 0
    IF FOCUS = 1 AND CMDIDX = 1 THEN PUTTXT 18, 25, "[投了]", 0, 9, C_BOLD ELSE PUTTXT 18, 25, "[投了]", 12, 0, 0
    IF FOCUS = 1 AND CMDIDX = 2 THEN PUTTXT 26, 25, "[終了]", 0, 9, C_BOLD ELSE PUTTXT 26, 25, "[終了]", 12, 0, 0
    IF FOCUS = 1 THEN DH$ = "←→:選択  Enter:決定  ↑:盤面へ"
    IF FOCUS = 2 THEN DH$ = "↑↓:持ち駒  Enter:決定  →:盤面へ"
    IF SELDROP <> 0 THEN DH$ = "↑↓←→:置く場所  Enter:決定  Tab:取消"
    IF SELFROM >= 0 THEN DH$ = "↑↓←→:移動先  Enter:決定  Tab:取消"
    IF FOCUS = 0 AND SELDROP = 0 AND SELFROM < 0 THEN DH$ = "←:持ち駒  ↓:メニュー  Enter:駒を選択"
    PUTTXT 0, 26, DH$, 12, 0, 0
END SUB

SUB DRAWMESSAGE
    CLEARROW 27
    IF HASMSG = 0 THEN EXIT SUB
    DMC = MSGCOL
    IF DMC = 1 THEN DMC = 9
    IF DMC = 2 THEN DMC = 10
    PUTTXT 0, 27, MSG$, DMC, 0, 0
END SUB

SUB SHOW
    IF SCREENRDY = 0 THEN Machine.TextClear Machine.TAttr(0, 0, 0): SCREENRDY = -1
    SYNCBOARD
    CLEARNONBOARD
    DRAWHEADER
    DRAWBOARD
    DRAWPANELS
    DRAWHINT
    DRAWMESSAGE
    Machine.Locate 0, 26
END SUB

SUB RESETMENU
    FOCUS = 0: CMDIDX = 0: HANDIDX = 0
    SELFROM = -1: SELDROP = 0: PROMCNT = 0: PROMIDX = 0
    CDR = 4: CDC = 4
    RMI = 0: RMFOUND = 0
    WHILE RMI < LEGALN AND RMFOUND = 0
        RMV = ULEGAL(RMI)
        IF RMV < DROP_FLAG THEN RMSQ = MOVEFROM(RMV): DISPLAYOF RMSQ, CDR, CDC: RMFOUND = -1
        RMI = RMI + 1
    WEND
END SUB

SUB SETMSG(SM$, SMCOL)
    MSG$ = SM$: MSGCOL = SMCOL: HASMSG = -1
END SUB

SUB ENTERCOMMANDS
    SELFROM = -1: SELDROP = 0
    PROMCNT = 0: PROMIDX = 0
    CMDIDX = 0
    FOCUS = 1
    HASMSG = 0
END SUB

SUB ENTERHAND
    HANDTYPES HUMAN
    IF HTN = 0 THEN SETMSG "持ち駒はありません。", 2: EXIT SUB
    EHI = 0
    FOR EHJ = 0 TO HTN - 1
        IF HTYPES(EHJ) = SELDROP THEN EHI = EHJ
    NEXT EHJ
    HANDIDX = EHI
    SELFROM = -1: SELDROP = 0
    PROMCNT = 0: PROMIDX = 0
    FOCUS = 2
    HASMSG = 0
END SUB

SUB CYCLEFOCUS
    IF FOCUS = 3 THEN PROMCNT = 0: PROMIDX = 0: FOCUS = 0: HASMSG = 0: EXIT SUB
    IF FOCUS = 0 THEN ENTERCOMMANDS: EXIT SUB
    IF FOCUS = 2 THEN FOCUS = 0: HASMSG = 0: EXIT SUB
    IF FOCUS = 1 THEN FOCUS = 0: HASMSG = 0: EXIT SUB
END SUB

FUNCTION BOARDENTER()
    BOARDENTER = -1
    BESQ = BOARDINDEX(CDR, CDC)
    IF SELDROP <> 0 THEN BEMV = DROP_FLAG + SELDROP * 100 + BESQ
    BEOK = 0
    IF SELDROP <> 0 AND HASLEGAL(BEMV) THEN BEOK = -1
    IF BEOK THEN SELDROP = 0: HASMSG = 0
    IF BEOK THEN BOARDENTER = BEMV
    IF BEOK THEN EXIT FUNCTION
    IF SELDROP <> 0 THEN SETMSG "そこには置けません。", 2: EXIT FUNCTION
    IF SELFROM < 0 THEN BEN = MOVESFROM(BESQ)
    IF SELFROM < 0 AND BEN = 0 THEN SETMSG "この駒は動かせません。", 2: EXIT FUNCTION
    IF SELFROM < 0 THEN SELFROM = BESQ: SETMSG "移動先を選んでください。", 1: EXIT FUNCTION
    IF BESQ = SELFROM THEN SELFROM = -1: PROMCNT = 0: HASMSG = 0: EXIT FUNCTION
    BEN = MOVESBETWEEN(SELFROM, BESQ)
    IF BEN = 0 THEN BEOTHER = MOVESFROM(BESQ)
    IF BEN = 0 AND BEOTHER = 0 THEN SETMSG "そこへは動かせません。", 2: EXIT FUNCTION
    IF BEN = 0 THEN SELFROM = BESQ: SETMSG "移動先を選んでください。", 1: EXIT FUNCTION
    IF BEN = 1 THEN BEMV = MOVES(20, 0)
    IF BEN = 1 THEN SELFROM = -1: PROMCNT = 0: HASMSG = 0
    IF BEN = 1 THEN BOARDENTER = BEMV
    IF BEN = 1 THEN EXIT FUNCTION
    BEUN = -1: BEUP = -1
    FOR BEI = 0 TO BEN - 1
        BEMV = MOVES(20, BEI)
        IF BEMV >= PROMOTE_FLAG THEN BEUP = BEMV ELSE BEUN = BEMV
    NEXT BEI
    PROMCNT = 0
    IF BEUN >= 0 THEN PROMMV(PROMCNT) = BEUN: PROMCNT = PROMCNT + 1
    IF BEUP >= 0 THEN PROMMV(PROMCNT) = BEUP: PROMCNT = PROMCNT + 1
    PROMIDX = 0
    FOCUS = 3
    HASMSG = 0
END FUNCTION

FUNCTION BOARDKEY(BKH)
    BOARDKEY = -1
    IF BKH = Machine.KEY_UP THEN IF CDR > 0 THEN CDR = CDR - 1: HASMSG = 0
    IF BKH = Machine.KEY_DOWN AND CDR < 8 THEN CDR = CDR + 1: HASMSG = 0
    IF BKH = Machine.KEY_DOWN AND CDR >= 8 THEN ENTERCOMMANDS
    IF BKH = Machine.KEY_LEFT AND CDC > 0 THEN CDC = CDC - 1: HASMSG = 0
    IF BKH = Machine.KEY_LEFT AND CDC = 0 THEN ENTERHAND
    IF BKH = Machine.KEY_RIGHT THEN IF CDC < 8 THEN CDC = CDC + 1: HASMSG = 0
    IF BKH = Machine.KEY_ENTER OR BKH = Machine.KEY_SPACE THEN BOARDKEY = BOARDENTER()
END FUNCTION

FUNCTION HANDKEY(HKT)
    HANDKEY = -1
    HANDTYPES HUMAN
    IF HTN = 0 THEN FOCUS = 0: EXIT FUNCTION
    IF HANDIDX < 0 OR HANDIDX >= HTN THEN HANDIDX = 0
    IF HKT = Machine.KEY_UP THEN HANDIDX = (HANDIDX + HTN - 1) MOD HTN: HASMSG = 0
    IF HKT = Machine.KEY_DOWN THEN HANDIDX = (HANDIDX + 1) MOD HTN: HASMSG = 0
    IF HKT = Machine.KEY_RIGHT THEN FOCUS = 0: HASMSG = 0
    IF HKT = Machine.KEY_ENTER OR HKT = Machine.KEY_SPACE THEN HKTYP = HTYPES(HANDIDX): HKN = DROPTARGETS(HKTYP)
    IF (HKT = Machine.KEY_ENTER OR HKT = Machine.KEY_SPACE) AND HKN = 0 THEN SETMSG "その持ち駒は置ける場所がありません。", 2: EXIT FUNCTION
    IF HKT = Machine.KEY_ENTER OR HKT = Machine.KEY_SPACE THEN SELDROP = HKTYP: SELFROM = -1: PROMCNT = 0: DISPLAYOF MOVETO(MOVES(20, 0)), CDR, CDC: FOCUS = 0: SETMSG "置く場所を選んでください。", 1
END FUNCTION

FUNCTION PROMKEY(PKH)
    PROMKEY = -1
    IF PROMCNT = 0 THEN EXIT FUNCTION
    IF PKH = Machine.KEY_LEFT OR PKH = Machine.KEY_RIGHT THEN PROMIDX = (PROMIDX + 1) MOD PROMCNT
    IF PKH = Machine.KEY_ENTER OR PKH = Machine.KEY_SPACE THEN PROMKEY = PROMMV(PROMIDX)
    IF PKH = Machine.KEY_ENTER OR PKH = Machine.KEY_SPACE THEN SELFROM = -1: SELDROP = 0: PROMCNT = 0: PROMIDX = 0: FOCUS = 0: HASMSG = 0
END FUNCTION

SUB DRAWMENU
    SYNCBOARD
    DRAWBOARD
    DRAWPANELS
    DRAWHINT
    DRAWMESSAGE
END SUB

FUNCTION HUMANMOVE()
    HUMANMOVE = -1
    WHILE 1
        HMHK = READKEY()
        IF HMHK = -1 THEN EXIT FUNCTION
        HMMV = -1
        IF HMHK = Machine.KEY_TAB THEN CYCLEFOCUS
        IF FOCUS = 3 THEN HMMV = PROMKEY(HMHK)
        IF FOCUS = 1 THEN IF HMHK = Machine.KEY_LEFT THEN CMDIDX = (CMDIDX + 2) MOD 3
        IF FOCUS = 1 THEN IF HMHK = Machine.KEY_RIGHT THEN CMDIDX = (CMDIDX + 1) MOD 3
        IF FOCUS = 1 THEN IF HMHK = Machine.KEY_UP THEN FOCUS = 0: HASMSG = 0
        IF FOCUS = 1 AND (HMHK = Machine.KEY_ENTER OR HMHK = Machine.KEY_SPACE) THEN IF CMDIDX = 0 THEN SETMSG "矢印:移動  Enter:選択/決定  左端←:持ち駒  下端↓:メニュー  Tab:切替", 1: FOCUS = 0
        IF FOCUS = 1 AND (HMHK = Machine.KEY_ENTER OR HMHK = Machine.KEY_SPACE) THEN IF CMDIDX = 1 THEN SETMSG "投了しました。", 1: SHOW: EXIT FUNCTION
        IF FOCUS = 1 AND (HMHK = Machine.KEY_ENTER OR HMHK = Machine.KEY_SPACE) THEN IF CMDIDX = 2 THEN SETMSG "終了します。", 1: SHOW: EXIT FUNCTION
        IF FOCUS = 2 THEN HMMV = HANDKEY(HMHK)
        IF FOCUS = 0 THEN HMMV = BOARDKEY(HMHK)
        IF HMMV >= 0 THEN HUMANMOVE = HMMV
        IF HMMV >= 0 THEN EXIT FUNCTION
        DRAWMENU
    WEND
END FUNCTION

' ---- 千日手 ----
FUNCTION SIGHASH1()
    SH = 0
    FOR SHI = 0 TO 80
        SH = SH * 31 + B(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
    NEXT SHI
    FOR SHI = 0 TO 7
        SH = SH * 31 + HB(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
        SH = SH * 31 + HW(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
    NEXT SHI
    SH = SH * 31 + TURN + 2
    SH = SH - INT(SH / 2147483647) * 2147483647
    SIGHASH1 = SH
END FUNCTION

FUNCTION SIGHASH2()
    SH = 0
    FOR SHI = 0 TO 80
        SH = SH * 37 + B(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
    NEXT SHI
    FOR SHI = 0 TO 7
        SH = SH * 37 + HB(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
        SH = SH * 37 + HW(SHI) + 32
        SH = SH - INT(SH / 2147483647) * 2147483647
    NEXT SHI
    SH = SH * 37 + TURN + 2
    SH = SH - INT(SH / 2147483647) * 2147483647
    SIGHASH2 = SH
END FUNCTION

SUB RECORDPOS
    RPH1 = SIGHASH1(): RPH2 = SIGHASH2(): RPSLOT = RPH1 - INT(RPH1 / 512) * 512
    RPTRY = 0
    WHILE RPTRY < 512 AND HISTU(RPSLOT) <> 0 AND (HIST1(RPSLOT) <> RPH1 OR HIST2(RPSLOT) <> RPH2)
        RPSLOT = RPSLOT + 1: IF RPSLOT >= 512 THEN RPSLOT = 0
        RPTRY = RPTRY + 1
    WEND
    IF RPTRY >= 512 THEN RPSLOT = 0
    IF HISTU(RPSLOT) = 0 THEN HISTU(RPSLOT) = -1: HIST1(RPSLOT) = RPH1: HIST2(RPSLOT) = RPH2: HISTC(RPSLOT) = 1 ELSE HISTC(RPSLOT) = HISTC(RPSLOT) + 1
END SUB

FUNCTION REPDRAW()
    RECORDPOS
    RDH1 = SIGHASH1(): RDH2 = SIGHASH2(): RDSLOT = RDH1 - INT(RDH1 / 512) * 512
    RDRET = 0
    RDT = 0
    WHILE RDT < 512 AND HISTU(RDSLOT) <> 0 AND (HIST1(RDSLOT) <> RDH1 OR HIST2(RDSLOT) <> RDH2)
        RDSLOT = RDSLOT + 1: IF RDSLOT >= 512 THEN RDSLOT = 0
        RDT = RDT + 1
    WEND
    IF HISTU(RDSLOT) <> 0 AND HISTC(RDSLOT) >= 4 THEN RDRET = -1
    REPDRAW = RDRET
END FUNCTION

' ---- 定跡と AI ----
FUNCTION OPENINGBOOK()
    OPENINGBOOK = -1
    IF INCHECK(TURN) THEN EXIT FUNCTION
    OBN1$ = "": OBN2$ = "": OBN3$ = ""
    IF TURN = 1 AND MOVENO = 1 THEN OBN1$ = "7g7f": OBN2$ = "2g2f"
    IF TURN = 1 AND MOVENO = 3 THEN OBN1$ = "2g2f": OBN2$ = "6g6f": OBN3$ = "5g5f"
    IF TURN = -1 AND MOVENO = 2 THEN OBN1$ = "3c3d": OBN2$ = "8c8d"
    IF TURN = -1 AND MOVENO = 4 THEN OBN1$ = "8c8d": OBN2$ = "2b3c": OBN3$ = "5c5d"
    IF OBN1$ = "" THEN EXIT FUNCTION
    COPYLEGAL
    OBMV = -1
    IF OBN1$ <> "" THEN OBMV = FINDROW(OBN1$, 0, LEGALN)
    IF OBMV < 0 AND OBN2$ <> "" THEN OBMV = FINDROW(OBN2$, 0, LEGALN)
    IF OBMV < 0 AND OBN3$ <> "" THEN OBMV = FINDROW(OBN3$, 0, LEGALN)
    OPENINGBOOK = OBMV
END FUNCTION

FUNCTION AIMOVE()
    AIMOVE = -1
    AMV = OPENINGBOOK()
    IF AMV >= 0 THEN SETMSG "AI: " + USINAME(AMV) + "（定跡）", 2: DRAWMESSAGE: AIMOVE = AMV: EXIT FUNCTION
    SETMSG "AI思考中...", 1
    DRAWMESSAGE
    AMT0 = Machine.Ms
    AMV = PICKMOVE()
    AMEL = Machine.Ms - AMT0
    IF AMV < 0 THEN EXIT FUNCTION
    SETMSG "AI: " + USINAME(AMV) + "（深さ " + NUMSTR(ENG_DEPTH) + "、 " + NUMSTR(ENG_NODES) + " ノード、 " + NUMSTR(AMEL) + " ms）", 2
    DRAWMESSAGE
    AIMOVE = AMV
END FUNCTION

SUB SHOWRESULT
    SRSIDE = TURN
    IF INCHECK(SRSIDE) AND SRSIDE = HUMAN THEN SETMSG "詰みました。あなたの負けです。", 2
    IF INCHECK(SRSIDE) AND SRSIDE <> HUMAN THEN SETMSG "詰みました。あなたの勝ちです！", 1
    IF INCHECK(SRSIDE) = 0 AND SRSIDE = HUMAN THEN SETMSG "指せる手がありません。あなたの負けです。", 2
    IF INCHECK(SRSIDE) = 0 AND SRSIDE <> HUMAN THEN SETMSG "指せる手がありません。あなたの勝ちです。", 1
    SHOW
    CLEARROW 27: CLEARROW 23: CLEARROW 24
    PUTTXT 0, 23, "対局ありがとうございました。", 3, 0, 0
    PUTTXT 0, 24, MSG$, 3, 0, 0
END SUB

SUB UIRESET
    HUMAN = 1: LASTMV = 0: HASLAST = 0: SCREENRDY = 0: SIDECHOICE = 0
    FOCUS = 0: CMDIDX = 0: HANDIDX = 0: CDR = 4: CDC = 4
    SELFROM = -1: SELDROP = 0: PROMCNT = 0: PROMIDX = 0
    BOARDACT = 0: LEGALN = 0: MSG$ = "": HASMSG = 0: MSGCOL = 0
    ENG_LIMIT = DEFAULT_TIME_MS: ENG_MAXDEPTH = DEFAULT_MAX_DEPTH
END SUB

SUB GAMERUN
    BANNER
    IF CHOOSESIDE() = 0 THEN EXIT SUB
    RECORDPOS
    WHILE 1
        LEGALN = LEGAL(TURN, 1, 0, 0)
        FOR GRI = 0 TO LEGALN - 1: ULEGAL(GRI) = MOVES(0, GRI): NEXT GRI
        IF TURN = HUMAN THEN RESETMENU
        SHOW
        IF LEGALN = 0 THEN SHOWRESULT: EXIT SUB
        GRMV = -1
        IF TURN = HUMAN THEN GRMV = HUMANMOVE()
        IF TURN <> HUMAN THEN GRMV = AIMOVE()
        IF GRMV < 0 THEN EXIT SUB
        GRU = DOMOVE(GRMV)
        LASTMV = GRMV: HASLAST = -1
        MOVENO = MOVENO + 1
        GRREP = REPDRAW()
        IF GRREP THEN LEGALN = LEGAL(TURN, 1, 0, 0)
        IF GRREP THEN FOR GRI = 0 TO LEGALN - 1: ULEGAL(GRI) = MOVES(0, GRI): NEXT GRI
        IF GRREP THEN SETMSG "千日手（同一局面4回）で引き分けです。", 1
        IF GRREP THEN SHOW
        IF GRREP THEN EXIT SUB
    WEND
END SUB

