END SUB

SUB DRAWSIDE
    CLEARROW 7: CLEARROW 8: CLEARROW 9
    PUTTXT 0, 7, "モードを選んでください", 15, 0, C_BOLD
    IF SIDECHOICE = 0 THEN PUTTXT 0, 8, "[ 先手（b） ]", 0, 9, C_BOLD
    IF SIDECHOICE = 0 THEN PUTTXT 22, 8, "[ 後手（w） ]", 15, 0, 0
    IF SIDECHOICE = 1 THEN PUTTXT 0, 8, "[ 先手（b） ]", 15, 0, 0
    IF SIDECHOICE = 1 THEN PUTTXT 22, 8, "[ 後手（w） ]", 0, 9, C_BOLD
    PUTTXT 0, 9, "←→:選択  Enter:決定  b/w でも選べます", 12, 0, 0
END SUB

FUNCTION CHOOSESIDE()
    CHOOSESIDE = 0
    CSDONE = 0
    SIDECHOICE = 0
    IF HUMAN = -1 THEN SIDECHOICE = 1
    CLRKEYS
    WHILE CSDONE = 0
        DRAWSIDE
        HK = READKEY()
        IF HK = -1 THEN EXIT FUNCTION
        IF HK = Machine.KEY_LEFT THEN SIDECHOICE = 0
        IF HK = Machine.KEY_RIGHT THEN SIDECHOICE = 1
        IF HK = Machine.KEY_ENTER OR HK = Machine.KEY_SPACE THEN HUMAN = 1
        IF (HK = Machine.KEY_ENTER OR HK = Machine.KEY_SPACE) AND SIDECHOICE = 1 THEN HUMAN = -1
        IF HK = Machine.KEY_ENTER OR HK = Machine.KEY_SPACE THEN CSDONE = -1
        IF HK = 98 OR HK = 66 THEN HUMAN = 1
        IF HK = 98 OR HK = 66 THEN CSDONE = -1
        IF HK = 119 OR HK = 87 THEN HUMAN = -1
        IF HK = 119 OR HK = 87 THEN CSDONE = -1
    WEND
    CHOOSESIDE = CSDONE
END FUNCTION

FUNCTION BOARDINDEX(BIDR, BIDC)
    IF HUMAN = 1 THEN BOARDINDEX = (8 - BIDC) * 9 + BIDR ELSE BOARDINDEX = BIDC * 9 + (8 - BIDR)
END FUNCTION

SUB DISPLAYOF(DSQ, DPRO, DPCO)
    IF HUMAN = 1 THEN DPRO = DSQ MOD 9: DPCO = 8 - INT(DSQ / 9)
    IF HUMAN = -1 THEN DPRO = 8 - DSQ MOD 9: DPCO = INT(DSQ / 9)
END SUB

FUNCTION BOARDCELL(BDR, BDC)
    BOARDCELL = B(BOARDINDEX(BDR, BDC))
END FUNCTION

FUNCTION MOVEFROM(MVF)
    MOVEFROM = -1
    IF MVF >= DROP_FLAG THEN EXIT FUNCTION
    MVB = MVF
    IF MVF >= PROMOTE_FLAG THEN MVB = MVF - PROMOTE_FLAG
    MOVEFROM = INT(MVB / 81)
END FUNCTION

FUNCTION MOVETO(MVT)
    IF MVT >= DROP_FLAG THEN MOVETO = (MVT - DROP_FLAG) MOD 100: EXIT FUNCTION
    MVB = MVT
    IF MVT >= PROMOTE_FLAG THEN MVB = MVT - PROMOTE_FLAG
    MOVETO = MVB MOD 81
END FUNCTION

FUNCTION DROPTYPE(MVD)
    IF MVD >= DROP_FLAG THEN DROPTYPE = INT((MVD - DROP_FLAG) / 100) ELSE DROPTYPE = 0
END FUNCTION

FUNCTION MOVESFROM(MFFRM)
    MN(20) = 0
    FOR MFI = 0 TO LEGALN - 1
        MFMV = ULEGAL(MFI)
        MFB = MFMV
        IF MFMV >= PROMOTE_FLAG THEN MFB = MFMV - PROMOTE_FLAG
        IF MFMV < DROP_FLAG AND INT(MFB / 81) = MFFRM THEN MOVES(20, MN(20)) = MFMV: MN(20) = MN(20) + 1
    NEXT MFI
    MOVESFROM = MN(20)
END FUNCTION

FUNCTION MOVESBETWEEN(MBFR, MBTO)
    MN(20) = 0
    FOR MBI = 0 TO LEGALN - 1
        MBMV = ULEGAL(MBI)
        MBB = MBMV
        IF MBMV >= PROMOTE_FLAG THEN MBB = MBMV - PROMOTE_FLAG
        IF MBMV < DROP_FLAG AND INT(MBB / 81) = MBFR AND MBB MOD 81 = MBTO THEN MOVES(20, MN(20)) = MBMV: MN(20) = MN(20) + 1
    NEXT MBI
    MOVESBETWEEN = MN(20)
END FUNCTION

FUNCTION DROPTARGETS(DTTYP)
    MN(20) = 0
    FOR DTI = 0 TO LEGALN - 1
        DTMV = ULEGAL(DTI)
        IF DTMV >= DROP_FLAG THEN IF INT((DTMV - DROP_FLAG) / 100) = DTTYP THEN MOVES(20, MN(20)) = DTMV: MN(20) = MN(20) + 1
    NEXT DTI
    DROPTARGETS = MN(20)
END FUNCTION

FUNCTION HASLEGAL(HLMV)
    HASLEGAL = 0
    FOR HLI = 0 TO LEGALN - 1
        IF ULEGAL(HLI) = HLMV THEN HASLEGAL = -1: EXIT FUNCTION
    NEXT HLI
END FUNCTION

FUNCTION FINDLEGAL(FLG$)
    FINDLEGAL = -1
    FGLEN = LEN(FLG$)
    IF FGLEN < 4 THEN EXIT FUNCTION
    FF = PARSESQ(FLG$, 0)
    FT = PARSESQ(FLG$, 2)
    IF FF < 0 OR FT < 0 THEN EXIT FUNCTION
    FB = FF * 81 + FT
    FOR FGI = 0 TO LEGALN - 1
        FGMV = ULEGAL(FGI)
        FGBASE = FGMV
        IF FGMV >= PROMOTE_FLAG THEN FGBASE = FGMV - PROMOTE_FLAG
        FGM = 0
        IF FGMV < DROP_FLAG AND FGBASE = FB THEN FGM = -1
        IF FGM AND FGLEN = 5 AND FGMV >= PROMOTE_FLAG THEN FINDLEGAL = FGMV: EXIT FUNCTION
        IF FGM AND FGLEN = 4 AND FGMV < PROMOTE_FLAG THEN FINDLEGAL = FGMV: EXIT FUNCTION
        IF FGM AND FGLEN = 4 AND FINDLEGAL < 0 THEN FINDLEGAL = FGMV
    NEXT FGI
END FUNCTION

SUB COPYLEGAL
    FOR CLI = 0 TO LEGALN - 1: MOVES(0, CLI) = ULEGAL(CLI): NEXT CLI
    MN(0) = LEGALN
END SUB

FUNCTION ACTIVESOURCE()
    ACTIVESOURCE = -1
    IF SELFROM >= 0 THEN ACTIVESOURCE = SELFROM: EXIT FUNCTION
    IF SELDROP <> 0 OR BOARDACT = 0 THEN EXIT FUNCTION
    ASQ = BOARDINDEX(CDR, CDC)
    IF MOVESFROM(ASQ) > 0 THEN ACTIVESOURCE = ASQ
END FUNCTION

SUB SOURCESQUARES
    FOR SSI = 0 TO 80: SRC(SSI) = 0: NEXT SSI
    FOR SSI = 0 TO LEGALN - 1
        SSMV = ULEGAL(SSI)
        IF SSMV < DROP_FLAG THEN SRC(MOVEFROM(SSMV)) = -1
    NEXT SSI
END SUB

SUB TARGETSQUARES
    FOR TSI = 0 TO 80: TGT(TSI) = 0: NEXT TSI
    IF SELDROP <> 0 THEN TSN = DROPTARGETS(SELDROP)
    IF SELDROP <> 0 THEN FOR TSI = 0 TO TSN - 1: TGT(MOVETO(MOVES(20, TSI))) = -1: NEXT TSI
    IF SELDROP <> 0 THEN EXIT SUB
    TSAS = ACTIVESOURCE()
    IF TSAS < 0 THEN EXIT SUB
    TSN = MOVESFROM(TSAS)
    FOR TSI = 0 TO TSN - 1: TGT(MOVETO(MOVES(20, TSI))) = -1: NEXT TSI
END SUB

SUB SYNCBOARD
    BOARDACT = 0
    IF TURN = HUMAN AND LEGALN > 0 AND (FOCUS = 0 OR FOCUS = 3) THEN BOARDACT = -1
END SUB

