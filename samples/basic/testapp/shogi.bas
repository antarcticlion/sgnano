' 将棋 - コンピュータ対戦（SG BASIC、2026-11-12）
' samples/python/testapp/shogi.py（MicroPython 版）の移植。テキスト面 80x30。
' ルール: 持ち駒・成り・王手・詰み・千日手。先手/後手を選べる。AI は反復深化 + 静止探索。
' SG BASIC の IF は 1 行だけ。変数は全部グローバルなので、関数/SUB の中の名前は
' 呼び出し元とぶつからないよう、手続きごとに別の接頭辞を付けている。
DEFDBL A-Z
BLACK = 1
WHITE = -1
PAWN = 1
LANCE = 2
KNIGHT = 3
SILVER = 4
GOLD = 5
BISHOP = 6
ROOK = 7
KING = 8
PROMOTE_FLAG = 100000
DROP_FLAG = 200000
MATE_SCORE = 1000000
INFINITY = 2000000
DEFAULT_TIME_MS = 2500
DEFAULT_MAX_DEPTH = 4
MAX_PLY = 16
C_BOLD = 65536
C_DW = 1048576
C_DH = 524288
C_LEFT = 8388608
C_RIGHT = 16777216
C_OVER = 32768
C_UNDER = 8192
C_ROT90 = 131072
C_ROT270 = 393216

' 盤と持ち駒
DIM B(80)
DIM HB(7), HW(7)
' 手のリスト（行 0 = UI/AI のルート、1..10 = AI の ply、11..16 = 合法手生成の作業）
DIM MOVES(31, 599)
DIM MN(31)
DIM ULEGAL(599)
DIM TGT(80), SRC(80)
DIM PROMOTE(8)
DIM NIFU(8)
DIM VALS(15), HVALS(7)
DIM DISPLAYCH$(8), PROMOTEDCH$(8)
' 方向表
DIM KDR(7), KDC(7), GDR(5), GDC(5), SDR(4), SDC(4), NDR(1), NDC(1), BDR(3), BDC(3), RDR(3), RDC(3)
' AI
DIM EHIST(6560)
DIM K1(127), K2(127)
DIM OKEY(599)
DIM NMI(MAX_PLY), NMBEST(MAX_PLY), NMLEGAL(MAX_PLY), NMU(MAX_PLY), NMMV(MAX_PLY), NMN(MAX_PLY)
DIM LGLLEGA(MAX_PLY)
DIM QI(MAX_PLY), QBEST(MAX_PLY), QLEGAL(MAX_PLY), QU(MAX_PLY), QMV(MAX_PLY)
DIM QOKA(MAX_PLY), QROWA(MAX_PLY), NROWA(MAX_PLY), NMOKA(MAX_PLY)
' 千日手
DIM HIST1(511), HIST2(511), HISTC(511), HISTU(511)
' UI
DIM PROMMV(1)

' ---- 初期化（定数表） ----
SUB INIT
    PROMOTE(0) = 0: PROMOTE(1) = 9: PROMOTE(2) = 10: PROMOTE(3) = 11
    PROMOTE(4) = 12: PROMOTE(5) = 0: PROMOTE(6) = 14: PROMOTE(7) = 15: PROMOTE(8) = 0
    VALS(0) = 0: VALS(1) = 100: VALS(2) = 300: VALS(3) = 350: VALS(4) = 450
    VALS(5) = 550: VALS(6) = 800: VALS(7) = 1000: VALS(8) = 0
    VALS(9) = 550: VALS(10) = 550: VALS(11) = 550: VALS(12) = 550
    VALS(13) = 550: VALS(14) = 1000: VALS(15) = 1200
    HVALS(0) = 0: HVALS(1) = 110: HVALS(2) = 320: HVALS(3) = 380
    HVALS(4) = 480: HVALS(5) = 580: HVALS(6) = 850: HVALS(7) = 1050
    DISPLAYCH$(0) = "": DISPLAYCH$(1) = "歩": DISPLAYCH$(2) = "香": DISPLAYCH$(3) = "桂"
    DISPLAYCH$(4) = "銀": DISPLAYCH$(5) = "金": DISPLAYCH$(6) = "角": DISPLAYCH$(7) = "飛": DISPLAYCH$(8) = "玉"
    PROMOTEDCH$(0) = "": PROMOTEDCH$(1) = "と": PROMOTEDCH$(2) = "杏": PROMOTEDCH$(3) = "圭"
    PROMOTEDCH$(4) = "全": PROMOTEDCH$(5) = "": PROMOTEDCH$(6) = "馬": PROMOTEDCH$(7) = "龍": PROMOTEDCH$(8) = ""
    KDR(0) = -1: KDC(0) = -1: KDR(1) = -1: KDC(1) = 0: KDR(2) = -1: KDC(2) = 1
    KDR(3) = 0: KDC(3) = -1: KDR(4) = 0: KDC(4) = 1
    KDR(5) = 1: KDC(5) = -1: KDR(6) = 1: KDC(6) = 0: KDR(7) = 1: KDC(7) = 1
    GDR(0) = -1: GDC(0) = -1: GDR(1) = -1: GDC(1) = 0: GDR(2) = -1: GDC(2) = 1
    GDR(3) = 0: GDC(3) = -1: GDR(4) = 0: GDC(4) = 1: GDR(5) = 1: GDC(5) = 0
    SDR(0) = -1: SDC(0) = -1: SDR(1) = -1: SDC(1) = 0: SDR(2) = -1: SDC(2) = 1
    SDR(3) = 1: SDC(3) = -1: SDR(4) = 1: SDC(4) = 1
    NDR(0) = -2: NDC(0) = -1: NDR(1) = -2: NDC(1) = 1
    BDR(0) = -1: BDC(0) = -1: BDR(1) = -1: BDC(1) = 1
    BDR(2) = 1: BDC(2) = -1: BDR(3) = 1: BDC(3) = 1
    RDR(0) = -1: RDC(0) = 0: RDR(1) = 1: RDC(1) = 0
    RDR(2) = 0: RDC(2) = -1: RDR(3) = 0: RDC(3) = 1
END SUB

SUB SETUP
    FOR STI = 0 TO 80: B(STI) = 0: NEXT STI
    FOR STI = 0 TO 7: HB(STI) = 0: HW(STI) = 0: NEXT STI
    DATA 2,3,4,5,8,5,4,3,2
    FOR STC = 0 TO 8
        READ STV
        B(STC) = -STV
        B(72 + STC) = STV
    NEXT STC
    B(10) = -ROOK: B(16) = -BISHOP: B(64) = BISHOP: B(70) = ROOK
    FOR STC = 0 TO 8
        B(18 + STC) = -PAWN
        B(54 + STC) = PAWN
    NEXT STC
    KINGB = 76: KINGW = 4
    TURN = BLACK: MOVENO = 1
END SUB

' ---- 基本 ----
FUNCTION KIND(KNDV)
    KNDT = ABS(KNDV)
    IF KNDT > 8 THEN KIND = KNDT - 8 ELSE KIND = KNDT
END FUNCTION

FUNCTION OWNER(OWV)
    IF OWV > 0 THEN OWNER = 1 ELSE OWNER = -1
END FUNCTION

FUNCTION FWD(FWS)
    IF FWS = 1 THEN FWD = -1 ELSE FWD = 1
END FUNCTION

FUNCTION SQNAME(SQI) AS STRING
    SQNAME = CHR$(48 + 9 - SQI MOD 9) + CHR$(97 + INT(SQI / 9))
END FUNCTION

FUNCTION USINAME(USMV) AS STRING
    IF USMV >= DROP_FLAG THEN USINAME = MID$(" PLNSGBRK", INT((USMV - DROP_FLAG) / 100) + 1, 1) + "*" + SQNAME((USMV - DROP_FLAG) MOD 100): EXIT FUNCTION
    USP = 0
    IF USMV >= PROMOTE_FLAG THEN USP = 1
    USB = USMV - PROMOTE_FLAG * USP
    US$ = SQNAME(INT(USB / 81)) + SQNAME(USB MOD 81)
    IF USP THEN US$ = US$ + "+"
    USINAME = US$
END FUNCTION

FUNCTION NUMSTR(NV) AS STRING
    NS$ = STR$(NV)
    IF LEFT$(NS$, 1) = " " THEN NUMSTR = MID$(NS$, 2) ELSE NUMSTR = NS$
END FUNCTION

FUNCTION HVAL(HS, HT)
    IF HT < 0 OR HT > 7 THEN HVAL = 0: EXIT FUNCTION
    IF HS = 1 THEN HVAL = HB(HT) ELSE HVAL = HW(HT)
END FUNCTION

SUB HSET(HS, HT, HV)
    IF HT < 0 OR HT > 7 THEN EXIT SUB
    IF HS = 1 THEN HB(HT) = HV ELSE HW(HT) = HV
END SUB

' ---- 利き ----
FUNCTION CLEARP(CPF, CPT)
    CPFR = INT(CPF / 9): CPFC = CPF - CPFR * 9
    CPTR = INT(CPT / 9): CPTC = CPT - CPTR * 9
    CPDR = 0: IF CPTR > CPFR THEN CPDR = 1 ELSE IF CPTR < CPFR THEN CPDR = -1
    CPDC = 0: IF CPTC > CPFC THEN CPDC = 1 ELSE IF CPTC < CPFC THEN CPDC = -1
    CPR = CPFR + CPDR: CPC = CPFC + CPDC
    WHILE CPR <> CPTR OR CPC <> CPTC
        IF CPR < 0 OR CPR > 8 OR CPC < 0 OR CPC > 8 THEN CLEARP = 0: EXIT FUNCTION
        IF B(CPR * 9 + CPC) <> 0 THEN CLEARP = 0: EXIT FUNCTION
        CPR = CPR + CPDR: CPC = CPC + CPDC
    WEND
    CLEARP = -1
END FUNCTION

FUNCTION GOLDSTEP(GSR, GSC, GSS)
    GSF = FWD(GSS)
    GOLDSTEP = (GSR = GSF AND ABS(GSC) <= 1) OR (GSR = 0 AND ABS(GSC) = 1) OR (GSR = -GSF AND GSC = 0)
END FUNCTION

FUNCTION KINGSTEP(KSR, KSC)
    KINGSTEP = (ABS(KSR) <= 1 AND ABS(KSC) <= 1 AND (KSR <> 0 OR KSC <> 0))
END FUNCTION

FUNCTION ATTACKS(AXF, AXT, AXP)
    ATTACKS = 0
    AXCODE = ABS(AXP): AXTYP = KIND(AXCODE)
    AXFR = INT(AXF / 9): AXFC = AXF - AXFR * 9
    AXTR = INT(AXT / 9): AXTC = AXT - AXTR * 9
    AXDR = AXTR - AXFR: AXDC = AXTC - AXFC
    IF AXDR = 0 AND AXDC = 0 THEN EXIT FUNCTION
    IF AXP > 0 THEN AXFWD = -1 ELSE AXFWD = 1
    IF AXCODE = KING THEN ATTACKS = KINGSTEP(AXDR, AXDC): EXIT FUNCTION
    IF AXCODE = 14 THEN IF ABS(AXDR) = ABS(AXDC) THEN ATTACKS = CLEARP(AXF, AXT): EXIT FUNCTION
    IF AXCODE = 14 THEN ATTACKS = (ABS(AXDR) + ABS(AXDC) = 1): EXIT FUNCTION
    IF AXCODE = 15 THEN IF AXDR = 0 OR AXDC = 0 THEN ATTACKS = CLEARP(AXF, AXT): EXIT FUNCTION
    IF AXCODE = 15 THEN ATTACKS = (ABS(AXDR) = 1 AND ABS(AXDC) = 1): EXIT FUNCTION
    IF AXCODE > 8 THEN ATTACKS = GOLDSTEP(AXDR, AXDC, AXFWD): EXIT FUNCTION
    IF AXTYP = PAWN THEN ATTACKS = (AXDR = AXFWD AND AXDC = 0): EXIT FUNCTION
    IF AXTYP = LANCE THEN IF AXDC = 0 AND AXDR * AXFWD > 0 THEN ATTACKS = CLEARP(AXF, AXT)
    IF AXTYP = LANCE THEN EXIT FUNCTION
    IF AXTYP = KNIGHT THEN ATTACKS = (AXDR = 2 * AXFWD AND ABS(AXDC) = 1): EXIT FUNCTION
    IF AXTYP = SILVER THEN ATTACKS = ((AXDR = AXFWD AND ABS(AXDC) <= 1) OR (AXDR = -AXFWD AND ABS(AXDC) = 1)): EXIT FUNCTION
    IF AXTYP = GOLD THEN ATTACKS = GOLDSTEP(AXDR, AXDC, AXFWD): EXIT FUNCTION
    IF AXTYP = BISHOP THEN IF ABS(AXDR) = ABS(AXDC) THEN ATTACKS = CLEARP(AXF, AXT)
    IF AXTYP = BISHOP THEN EXIT FUNCTION
    IF AXTYP = ROOK THEN IF AXDR = 0 OR AXDC = 0 THEN ATTACKS = CLEARP(AXF, AXT)
    IF AXTYP = ROOK THEN EXIT FUNCTION
END FUNCTION

FUNCTION ATTACKED(ATQ, ATBY)
    ATTACKED = 0
    FOR ATF = 0 TO 80
        ATP = B(ATF)
        IF ATP <> 0 THEN IF OWNER(ATP) = ATBY THEN IF ATTACKS(ATF, ATQ, ATP) THEN ATTACKED = -1: EXIT FUNCTION
    NEXT ATF
END FUNCTION

FUNCTION INCHECK(ICS)
    IF ICS = 1 THEN ICK = KINGB ELSE ICK = KINGW
    INCHECK = ATTACKED(ICK, -ICS)
END FUNCTION

' ---- 手の生成 ----
SUB ADDMOVE(AMR, AMF, AMT, AMS, AMC)
    AMN = MN(AMR)
    IF AMN >= 599 THEN EXIT SUB
    AMBASE = AMF * 81 + AMT
    AMTYP = KIND(AMC)
    AMLAST = 0
    IF AMS = -1 THEN AMLAST = 8
    AMUST = 0
    IF (AMTYP = PAWN OR AMTYP = LANCE) AND INT(AMT / 9) = AMLAST THEN AMUST = -1
    IF AMTYP = KNIGHT AND ((AMS = 1 AND INT(AMT / 9) <= 1) OR (AMS = -1 AND INT(AMT / 9) >= 7)) THEN AMUST = -1
    AMZONE = 0
    IF AMS = 1 AND (INT(AMF / 9) <= 2 OR INT(AMT / 9) <= 2) THEN AMZONE = -1
    IF AMS = -1 AND (INT(AMF / 9) >= 6 OR INT(AMT / 9) >= 6) THEN AMZONE = -1
    AMP = 0
    IF AMC <= 8 AND PROMOTE(AMTYP) <> 0 AND AMZONE THEN AMP = -1
    IF AMP AND AMUST THEN MOVES(AMR, AMN) = AMBASE + PROMOTE_FLAG: MN(AMR) = AMN + 1: EXIT SUB
    IF AMP AND AMUST = 0 THEN MOVES(AMR, AMN) = AMBASE: MOVES(AMR, AMN + 1) = AMBASE + PROMOTE_FLAG: MN(AMR) = AMN + 2: EXIT SUB
    MOVES(AMR, AMN) = AMBASE
    MN(AMR) = AMN + 1
END SUB

SUB ADDSTEP(ASR, ASF, ASNR, ASNC, ASS, ASTC)
    IF ASNR < 0 OR ASNR > 8 OR ASNC < 0 OR ASNC > 8 THEN EXIT SUB
    ASTO = ASNR * 9 + ASNC
    ASQ = B(ASTO)
    IF ASQ <> 0 AND OWNER(ASQ) = ASS THEN EXIT SUB
    ADDMOVE ASR, ASF, ASTO, ASS, ASTC
END SUB

SUB ADDSLIDE(ALR, ALF, ALDR, ALDC, ALS, ALC)
    ALFR = INT(ALF / 9): ALFC = ALF - ALFR * 9
    ALRR = ALFR + ALDR: ALLC = ALFC + ALDC
    WHILE ALRR >= 0 AND ALRR <= 8 AND ALLC >= 0 AND ALLC <= 8
        ALTO = ALRR * 9 + ALLC
        ALQ = B(ALTO)
        IF ALQ = 0 THEN ADDMOVE ALR, ALF, ALTO, ALS, ALC
        IF ALQ <> 0 THEN IF OWNER(ALQ) <> ALS THEN ADDMOVE ALR, ALF, ALTO, ALS, ALC
        IF ALQ <> 0 THEN EXIT SUB
        ALRR = ALRR + ALDR: ALLC = ALLC + ALDC
    WEND
END SUB

SUB GENKING(GKR, GKF, GKR0, GKC0, GKS, GKC)
    FOR GKI = 0 TO 7: ADDSTEP GKR, GKF, GKR0 + KDR(GKI), GKC0 + KDC(GKI), GKS, GKC: NEXT GKI
END SUB
SUB GENHORSE(GHR, GHF, GHR0, GHC0, GHS, GHC)
    FOR GHI = 0 TO 3: ADDSLIDE GHR, GHF, BDR(GHI), BDC(GHI), GHS, GHC: NEXT GHI
    FOR GHI = 0 TO 3: ADDSTEP GHR, GHF, GHR0 + RDR(GHI), GHC0 + RDC(GHI), GHS, GHC: NEXT GHI
END SUB
SUB GENDRAGON(GDRR, GDRF, GDR0, GDC0, GDRS, GDRC)
    FOR GDRI = 0 TO 3: ADDSLIDE GDRR, GDRF, RDR(GDRI), RDC(GDRI), GDRS, GDRC: NEXT GDRI
    FOR GDRI = 0 TO 3: ADDSTEP GDRR, GDRF, GDR0 + BDR(GDRI), GDC0 + BDC(GDRI), GDRS, GDRC: NEXT GDRI
END SUB
SUB GENGOLD(GGR, GGF, GGR0, GGC0, GGS, GGC)
    FOR GGI = 0 TO 5: ADDSTEP GGR, GGF, GGR0 + GDR(GGI) * GGS, GGC0 + GDC(GGI), GGS, GGC: NEXT GGI
END SUB
SUB GENSILVER(GSR2, GSF2, GSR20, GSC20, GSS2, GSC2)
    FOR GSI = 0 TO 4: ADDSTEP GSR2, GSF2, GSR20 + SDR(GSI) * GSS2, GSC20 + SDC(GSI), GSS2, GSC2: NEXT GSI
END SUB
SUB GENKNIGHT(GNR, GNF, GNR0, GNC0, GNS, GNC)
    FOR GNI = 0 TO 1: ADDSTEP GNR, GNF, GNR0 + NDR(GNI) * GNS, GNC0 + NDC(GNI), GNS, GNC: NEXT GNI
END SUB
SUB GENPAWN(GPR, GPF, GPR0, GPC0, GPS, GPC)
    ADDSTEP GPR, GPF, GPR0 - GPS, GPC0, GPS, GPC
END SUB
SUB GENLANCE(GLR, GLF, GLR0, GLC0, GLS, GLC)
    ADDSLIDE GLR, GLF, -GLS, 0, GLS, GLC
END SUB
SUB GENBISHOP(GBR, GBF, GBR0, GBC0, GBS, GBC)
    FOR GBI = 0 TO 3: ADDSLIDE GBR, GBF, BDR(GBI), BDC(GBI), GBS, GBC: NEXT GBI
END SUB
SUB GENROOK(GRR, GRF, GRR0, GRC0, GRS, GRC)
    FOR GRI = 0 TO 3: ADDSLIDE GRR, GRF, RDR(GRI), RDC(GRI), GRS, GRC: NEXT GRI
END SUB

SUB SETNIFU(NSIDE)
    FOR NSI = 0 TO 8: NIFU(NSI) = 0: NEXT NSI
    FOR NSI = 0 TO 8
        FOR NSJ = 0 TO 8
            IF B(NSJ * 9 + NSI) = NSIDE * PAWN THEN NIFU(NSI) = -1
        NEXT NSJ
    NEXT NSI
END SUB

SUB PSEUDO(PSSIDE, PSDROPS, PSROW)
    MN(PSROW) = 0
    FOR PSF = 0 TO 80
        PSQ = B(PSF)
        PSUse = 0
        IF PSQ <> 0 AND OWNER(PSQ) = PSSIDE THEN PSUse = -1
        PSCODE = 0: PSTYP = 0: PSR = 0: PSC = 0
        IF PSUse THEN PSCODE = ABS(PSQ): PSTYP = KIND(PSCODE): PSR = INT(PSF / 9): PSC = PSF - PSR * 9
        IF PSUse AND PSCODE = KING THEN GENKING PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE = 14 THEN GENHORSE PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE = 15 THEN GENDRAGON PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE > 8 AND PSCODE <> 14 AND PSCODE <> 15 THEN GENGOLD PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE = GOLD THEN GENGOLD PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = SILVER THEN GENSILVER PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = KNIGHT THEN GENKNIGHT PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = PAWN THEN GENPAWN PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = LANCE THEN GENLANCE PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = BISHOP THEN GENBISHOP PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
        IF PSUse AND PSCODE <= 8 AND PSTYP = ROOK THEN GENROOK PSROW, PSF, PSR, PSC, PSSIDE, PSCODE
    NEXT PSF
    IF PSDROPS = 0 THEN EXIT SUB
    HDROP = HVAL(PSSIDE, PAWN)
    IF HDROP > 0 THEN SETNIFU PSSIDE
    FOR PST = 1 TO 7
        PSTH = HVAL(PSSIDE, PST)
        FOR PSTO = 0 TO 80
            PSTY = 1
            IF PSTH > 0 AND B(PSTO) = 0 THEN PSTY = 0
            IF PST = PAWN AND (INT(PSTO / 9) = 0 OR INT(PSTO / 9) = 8) THEN PSTY = 1
            IF PST = PAWN AND NIFU(PSTO MOD 9) <> 0 THEN PSTY = 1
            IF PST = LANCE AND (INT(PSTO / 9) = 0 OR INT(PSTO / 9) = 8) THEN PSTY = 1
            IF PST = KNIGHT AND (INT(PSTO / 9) <= 1 OR INT(PSTO / 9) >= 7) THEN PSTY = 1
            IF PSTY = 0 AND MN(PSROW) < 599 THEN MOVES(PSROW, MN(PSROW)) = DROP_FLAG + PST * 100 + PSTO: MN(PSROW) = MN(PSROW) + 1
        NEXT PSTO
    NEXT PST
END SUB

' ---- 指し手の実行 ----
FUNCTION DOMOVE(DMMV)
    DMSIDE = TURN
    DMISDROP = 0
    IF DMMV >= DROP_FLAG THEN DMISDROP = -1
    IF DMISDROP THEN DMREST = DMMV - DROP_FLAG: DMTYP = INT(DMREST / 100): DMTO = DMREST - DMTYP * 100: B(DMTO) = DMSIDE * DMTYP: HSET DMSIDE, DMTYP, HVAL(DMSIDE, DMTYP) - 1: DOMOVE = DMMV * 64 + 32: TURN = -DMSIDE: EXIT FUNCTION
    DMPROM = 0: IF DMMV >= PROMOTE_FLAG THEN DMPROM = 1
    DMBASE = DMMV - PROMOTE_FLAG * DMPROM
    DMFR = INT(DMBASE / 81): DMTO = DMBASE - DMFR * 81
    DMQ = B(DMFR): DMCODE = ABS(DMQ)
    DMCAP = B(DMTO)
    IF DMCAP <> 0 THEN IF ABS(DMCAP) <> KING THEN HSET DMSIDE, KIND(DMCAP), HVAL(DMSIDE, KIND(DMCAP)) + 1
    IF DMPROM THEN B(DMTO) = PROMOTE(DMCODE) * DMSIDE ELSE B(DMTO) = DMQ
    B(DMFR) = 0
    IF DMCODE = KING THEN IF DMSIDE = 1 THEN KINGB = DMTO ELSE KINGW = DMTO
    DOMOVE = DMMV * 64 + (DMCAP + 32)
    TURN = -DMSIDE
END FUNCTION

SUB UNDOMOVE(UMU)
    UMMV = INT(UMU / 64)
    UMCAP = (UMU - UMMV * 64) - 32
    TURN = -TURN
    UMSIDE = TURN
    UMISDROP = 0
    IF UMMV >= DROP_FLAG THEN UMISDROP = -1
    IF UMISDROP THEN UMREST = UMMV - DROP_FLAG: UMTYP = INT(UMREST / 100): UMTO = UMREST - UMTYP * 100: B(UMTO) = 0: HSET UMSIDE, UMTYP, HVAL(UMSIDE, UMTYP) + 1: EXIT SUB
    UMPROM = 0: IF UMMV >= PROMOTE_FLAG THEN UMPROM = 1
    UMBASE = UMMV - PROMOTE_FLAG * UMPROM
    UMFR = INT(UMBASE / 81): UMTO = UMBASE - UMFR * 81
    UMQ = B(UMTO): UMCODE = ABS(UMQ)
    IF UMPROM THEN UMORIG = UMCODE - 8 ELSE UMORIG = UMCODE
    B(UMFR) = UMORIG * UMSIDE
    B(UMTO) = UMCAP
    IF UMCAP <> 0 THEN IF ABS(UMCAP) <> KING THEN HSET UMSIDE, KIND(UMCAP), HVAL(UMSIDE, KIND(UMCAP)) - 1
    IF UMORIG = KING THEN IF UMSIDE = 1 THEN KINGB = UMFR ELSE KINGW = UMFR
END SUB

FUNCTION LEGAL(LGSIDE, LGCHK, LGOUT, LGDEP)
    PSEUDO LGSIDE, 1, 11 + LGDEP
    LGLI(LGDEP) = 0: LGLN(LGDEP) = 0
    WHILE LGLI(LGDEP) < MN(11 + LGDEP)
        LGLMV(LGDEP) = MOVES(11 + LGDEP, LGLI(LGDEP))
        LGLU(LGDEP) = DOMOVE(LGLMV(LGDEP))
        LGLLEGA(LGDEP) = -1
        IF INCHECK(LGSIDE) THEN LGLLEGA(LGDEP) = 0
        IF LGLLEGA(LGDEP) AND LGCHK AND LGLMV(LGDEP) >= DROP_FLAG THEN LGREST = LGLMV(LGDEP) - DROP_FLAG: IF INT(LGREST / 100) = PAWN THEN IF INCHECK(TURN) THEN LGNR = LEGAL(TURN, 0, 15, LGDEP + 1): IF LGNR = 0 THEN LGLLEGA(LGDEP) = 0
        UNDOMOVE LGLU(LGDEP)
        IF LGLLEGA(LGDEP) THEN MOVES(LGOUT, LGLN(LGDEP)) = LGLMV(LGDEP): LGLN(LGDEP) = LGLN(LGDEP) + 1
        LGLI(LGDEP) = LGLI(LGDEP) + 1
    WEND
    LEGAL = LGLN(LGDEP)
END FUNCTION

' ---- 評価と探索 ----
FUNCTION EVALUATE()
    EVS = 0
    FOR EVI = 0 TO 80
        EVQ = B(EVI)
        EVUSE = 0
        IF EVQ <> 0 THEN EVUSE = -1
        EVSIDE = 1: EVCODE = 0: EVV = 0: EVR = 0: EVC = 0
        IF EVUSE THEN EVSIDE = 1: IF EVQ < 0 THEN EVSIDE = -1: EVCODE = ABS(EVQ): EVV = VALS(EVCODE): EVR = INT(EVI / 9): EVC = EVI - EVR * 9
        IF EVUSE AND EVCODE = PAWN THEN EVV = EVV + ((6 - EVR) * (EVSIDE = 1) + (EVR - 2) * (EVSIDE = -1)) * 6
        IF EVUSE AND EVCODE = LANCE THEN EVV = EVV + ((6 - EVR) * (EVSIDE = 1) + (EVR - 2) * (EVSIDE = -1)) * 3
        IF EVUSE AND EVCODE = KNIGHT THEN EVV = EVV + ((6 - EVR) * (EVSIDE = 1) + (EVR - 2) * (EVSIDE = -1)) * 4
        IF EVUSE AND EVCODE = SILVER THEN EVV = EVV + ((6 - EVR) * (EVSIDE = 1) + (EVR - 2) * (EVSIDE = -1)) * 3
        IF EVUSE AND (EVCODE = BISHOP OR EVCODE = ROOK) THEN EVV = EVV + (4 - (ABS(EVR - 4) + ABS(EVC - 4))) * 2
        IF EVUSE AND EVCODE = KING THEN IF (EVSIDE = 1 AND EVR >= 7) OR (EVSIDE = -1 AND EVR <= 1) THEN EVV = EVV + 30
        EVS = EVS + EVV * EVSIDE
    NEXT EVI
    FOR EVT = 1 TO 7
        EVS = EVS + HB(EVT) * HVALS(EVT) - HW(EVT) * HVALS(EVT)
    NEXT EVT
    IF TURN = 1 THEN EVALUATE = EVS ELSE EVALUATE = -EVS
END FUNCTION

FUNCTION MOVEKEY(MKMV, MKFIRST, MKPLY)
    MKK1 = 0: MKK2 = 0
    IF MKPLY < 128 THEN MKK1 = K1(MKPLY): MKK2 = K2(MKPLY)
    IF MKMV = MKFIRST THEN MOVEKEY = 100000000: EXIT FUNCTION
    IF MKMV >= DROP_FLAG THEN MOVEKEY = 0: EXIT FUNCTION
    MKBASE = MKMV: IF MKMV >= PROMOTE_FLAG THEN MKBASE = MKMV - PROMOTE_FLAG
    MKFRM = INT(MKBASE / 81): MKTO = MKBASE - MKFRM * 81
    MKV = B(MKTO)
    IF MKV <> 0 THEN MOVEKEY = 100000 + VALS(ABS(MKV)) * 10 - VALS(ABS(B(MKFRM))): EXIT FUNCTION
    IF MKMV >= PROMOTE_FLAG THEN MOVEKEY = 50000: EXIT FUNCTION
    IF MKMV = MKK1 THEN MOVEKEY = 40000: EXIT FUNCTION
    IF MKMV = MKK2 THEN MOVEKEY = 39000: EXIT FUNCTION
    MOVEKEY = EHIST(MKFRM * 81 + MKTO)
END FUNCTION

SUB ORDER(ORR, ORN, ORF, ORP)
    FOR ORDI = 0 TO ORN - 1: OKEY(ORDI) = MOVEKEY(MOVES(ORR, ORDI), ORF, ORP): NEXT ORDI
    FOR ORDI = 1 TO ORN - 1
        ORDMV = MOVES(ORR, ORDI): ORDKV = OKEY(ORDI): ORDJ = ORDI - 1
        WHILE ORDJ >= 0
            IF OKEY(ORDJ) < ORDKV THEN MOVES(ORR, ORDJ + 1) = MOVES(ORR, ORDJ): OKEY(ORDJ + 1) = OKEY(ORDJ): ORDJ = ORDJ - 1 ELSE ORDJ = -1
        WEND
        MOVES(ORR, ORDJ + 1) = ORDMV
        OKEY(ORDJ + 1) = ORDKV
    NEXT ORDI
END SUB

SUB CAPTURE(CAROW)
    PSEUDO TURN, 0, CAROW
    CAC = 0
    FOR CAI = 0 TO MN(CAROW) - 1
        CAMV = MOVES(CAROW, CAI)
        CABASE = CAMV: IF CAMV >= PROMOTE_FLAG THEN CABASE = CAMV - PROMOTE_FLAG
        CATO = CABASE MOD 81
        IF B(CATO) <> 0 OR CAMV >= PROMOTE_FLAG THEN MOVES(CAROW, CAC) = CAMV: CAC = CAC + 1
    NEXT CAI
    MN(CAROW) = CAC
END SUB

SUB CUTOFF(COMV, COD, COP)
    COUSED = 0
    IF COMV < DROP_FLAG THEN COUSED = -1
    IF COUSED THEN COBASE = COMV: IF COMV >= PROMOTE_FLAG THEN COBASE = COMV - PROMOTE_FLAG: COFR = INT(COBASE / 81): COTO = COBASE - COFR * 81: EHIST(COFR * 81 + COTO) = EHIST(COFR * 81 + COTO) + COD * COD: IF K1(COP) <> COMV THEN K2(COP) = K1(COP): K1(COP) = COMV
END SUB

FUNCTION POSHASH()
    PH = 0
    FOR PHI = 0 TO 80: PH = PH + B(PHI) * (PHI + 1): NEXT PHI
    FOR PHI = 0 TO 7: PH = PH + HB(PHI) * 1000 + HW(PHI) * 2000: NEXT PHI
    POSHASH = PH + TURN * 1000000
END FUNCTION


FUNCTION QUIESCE(QA, QB, QP, QD)
    ENG_NODES = ENG_NODES + 1
    IF ENG_NODES = INT(ENG_NODES / 8) * 8 AND TIMEOUT <> 0 THEN QUIESCE = 0: EXIT FUNCTION
    IF ENG_NODES = INT(ENG_NODES / 8) * 8 AND Machine.Ms >= ENG_DEADLINE THEN TIMEOUT = -1: QUIESCE = 0: EXIT FUNCTION
    QCHK = INCHECK(TURN)
    QSTAND = 0
    IF NOT QCHK THEN QSTAND = EVALUATE()
    IF NOT QCHK AND QSTAND >= QB THEN QUIESCE = QSTAND: EXIT FUNCTION
    IF NOT QCHK AND QSTAND > QA THEN QA = QSTAND
    IF QD >= 4 THEN QUIESCE = EVALUATE(): EXIT FUNCTION
    QROWA(QP) = QP + 1: IF QROWA(QP) > MAX_PLY THEN QROWA(QP) = MAX_PLY
    IF QCHK THEN PSEUDO TURN, 1, QROWA(QP) ELSE CAPTURE QROWA(QP)
    ORDER QROWA(QP), MN(QROWA(QP)), 0, QP
    QBEST(QP) = -INFINITY: IF NOT QCHK THEN QBEST(QP) = QA
    QLEGAL(QP) = 0: QI(QP) = 0
    WHILE QI(QP) < MN(QROWA(QP))
        QMV(QP) = MOVES(QROWA(QP), QI(QP))
        QU(QP) = DOMOVE(QMV(QP))
        QMOVER = -TURN
        QOKA(QP) = 0: IF NOT INCHECK(QMOVER) THEN QOKA(QP) = -1
        IF QOKA(QP) THEN QLEGAL(QP) = QLEGAL(QP) + 1: QVAL = -QUIESCE(-QB, -QBEST(QP), QP + 1, QD + 1)
        IF QOKA(QP) THEN UNDOMOVE QU(QP)
        IF QOKA(QP) = 0 THEN UNDOMOVE QU(QP)
        IF QOKA(QP) AND TIMEOUT THEN QUIESCE = 0: EXIT FUNCTION
        IF QOKA(QP) AND QVAL > QBEST(QP) THEN QBEST(QP) = QVAL
        IF QOKA(QP) AND QBEST(QP) >= QB THEN QUIESCE = QBEST(QP): EXIT FUNCTION
        QI(QP) = QI(QP) + 1
    WEND
    IF QCHK AND QLEGAL(QP) = 0 THEN QUIESCE = -MATE_SCORE + QP ELSE QUIESCE = QBEST(QP)
END FUNCTION

FUNCTION NEGAMAX(ND, NA, NB, NP, NQ)
    ENG_NODES = ENG_NODES + 1
    IF ENG_NODES = INT(ENG_NODES / 8) * 8 AND TIMEOUT <> 0 THEN NEGAMAX = 0: EXIT FUNCTION
    IF ENG_NODES = INT(ENG_NODES / 8) * 8 AND Machine.Ms >= ENG_DEADLINE THEN TIMEOUT = -1: NEGAMAX = 0: EXIT FUNCTION
    IF ND <= 0 THEN IF NQ THEN NEGAMAX = QUIESCE(NA, NB, NP, 0) ELSE NEGAMAX = EVALUATE()
    IF ND <= 0 THEN EXIT FUNCTION
    NROWA(NP) = NP: IF NROWA(NP) > MAX_PLY THEN NROWA(NP) = MAX_PLY
    PSEUDO TURN, 1, NROWA(NP)
    ORDER NROWA(NP), MN(NROWA(NP)), 0, NP
    NMBEST(NP) = -INFINITY: NMLEGAL(NP) = 0: NMI(NP) = 0
    WHILE NMI(NP) < MN(NROWA(NP))
        NMMV(NP) = MOVES(NROWA(NP), NMI(NP))
        NMU(NP) = DOMOVE(NMMV(NP))
        NMMOVER = -TURN
        NMOKA(NP) = 0
        IF NOT INCHECK(NMMOVER) THEN NMOKA(NP) = -1
        IF NMOKA(NP) THEN NMLEGAL(NP) = NMLEGAL(NP) + 1: NMVAL = -NEGAMAX(ND - 1, -NB, -NA, NP + 1, NQ)
        IF NMOKA(NP) THEN UNDOMOVE NMU(NP)
        IF NMOKA(NP) = 0 THEN UNDOMOVE NMU(NP)
        IF NMOKA(NP) AND TIMEOUT THEN NEGAMAX = 0: EXIT FUNCTION
        IF NMOKA(NP) AND NMVAL > NMBEST(NP) THEN NMBEST(NP) = NMVAL
        IF NMOKA(NP) AND NMBEST(NP) > NA THEN NA = NMBEST(NP)
        IF NMOKA(NP) AND NA >= NB THEN CUTOFF NMMV(NP), ND, NP: EXIT FUNCTION
        NMI(NP) = NMI(NP) + 1
    WEND
    IF NMLEGAL(NP) = 0 THEN NEGAMAX = -MATE_SCORE + NP ELSE NEGAMAX = NMBEST(NP)
END FUNCTION

FUNCTION ROOTSEARCH(ROROW, RON, ROD, ROU)
    RSA = -INFINITY: RSB = INFINITY: RSBS = -INFINITY
    ROOTBEST = MOVES(ROROW, 0)
    FOR RSI = 0 TO RON - 1
        IF Machine.Ms >= ENG_DEADLINE THEN TIMEOUT = -1: ROOTSEARCH = 0: EXIT FUNCTION
        RSMV = MOVES(ROROW, RSI)
        RSU = DOMOVE(RSMV)
        IF ROD <= 1 AND ROU = 0 THEN RSV = -EVALUATE() ELSE RSV = -NEGAMAX(ROD - 1, -RSB, -RSA, 1, ROU)
        UNDOMOVE RSU
        IF TIMEOUT THEN ROOTSEARCH = 0: EXIT FUNCTION
        IF RSV > RSBS THEN RSBS = RSV: ROOTBEST = RSMV
        IF RSBS > RSA THEN RSA = RSBS
    NEXT RSI
    ROOTSCORE = RSBS
    ROOTSEARCH = -1
END FUNCTION

FUNCTION PICKMOVE()
    ENG_DEADLINE = Machine.Ms + ENG_LIMIT
    ENG_NODES = 0: ENG_DEPTH = 0: ENG_SCORE = 0: TIMEOUT = 0
    CMN = LEGAL(TURN, 1, 0, 0)
    IF CMN = 0 THEN PICKMOVE = -1
    IF CMN = 0 THEN EXIT FUNCTION
    CMBEST = MOVES(0, 0)
    ORDER 0, CMN, CMBEST, 0
    CMOK = 0
    CMTMP = ROOTSEARCH(0, CMN, 1, 0)
    IF CMTMP THEN CMOK = -1
    IF CMOK THEN ENG_SCORE = ROOTSCORE: ENG_DEPTH = 1: CMBEST = ROOTBEST
    IF CMOK = 0 THEN PICKMOVE = CMBEST
    IF CMOK = 0 THEN EXIT FUNCTION
    CMSEARCH = 0
    IF Machine.Ms < ENG_DEADLINE THEN CMSEARCH = -1
    IF CMSEARCH THEN ORDER 0, CMN, CMBEST, 0
    CMOK = 0
    CMTMP = 0
    IF CMSEARCH THEN CMTMP = ROOTSEARCH(0, CMN, 1, -1)
    IF CMTMP THEN CMOK = -1
    IF CMOK THEN ENG_SCORE = ROOTSCORE: CMBEST = ROOTBEST
    IF CMSEARCH AND CMOK = 0 THEN PICKMOVE = CMBEST
    IF CMSEARCH AND CMOK = 0 THEN EXIT FUNCTION
    CMD = 2
    CMSTOP = 0
    WHILE CMD <= ENG_MAXDEPTH AND CMSTOP = 0
        IF Machine.Ms >= ENG_DEADLINE THEN CMSTOP = -1
        IF CMSTOP = 0 THEN ORDER 0, CMN, CMBEST, 0
        IF CMSTOP = 0 THEN CMTMP = ROOTSEARCH(0, CMN, CMD, -1)
        IF CMSTOP = 0 AND CMTMP = 0 THEN CMSTOP = -1
        IF CMSTOP = 0 THEN CMBEST = ROOTBEST: ENG_SCORE = ROOTSCORE: ENG_DEPTH = CMD
        IF CMSTOP = 0 AND ABS(ROOTSCORE) > MATE_SCORE - 1000 THEN CMSTOP = -1
        CMD = CMD + 1
    WEND
    PICKMOVE = CMBEST
END FUNCTION

FUNCTION PARSESQ(PSQ$, PSI)
    PARSESQ = -1
    IF LEN(PSQ$) < PSI + 2 THEN EXIT FUNCTION
    PSF = ASC(MID$(PSQ$, PSI + 1, 1))
    PSR = ASC(MID$(PSQ$, PSI + 2, 1))
    IF PSF < 49 OR PSF > 57 THEN EXIT FUNCTION
    IF PSR >= 65 AND PSR <= 90 THEN PSR = PSR + 32
    IF PSR < 97 OR PSR > 105 THEN EXIT FUNCTION
    PARSESQ = (PSR - 97) * 9 + (57 - PSF)
END FUNCTION

FUNCTION PIECETYPE(PBT)
    IF PBT >= 97 AND PBT <= 122 THEN PBT = PBT - 32
    PIECETYPE = 0
    IF PBT = 80 THEN PIECETYPE = PAWN
    IF PBT = 76 THEN PIECETYPE = LANCE
    IF PBT = 78 THEN PIECETYPE = KNIGHT
    IF PBT = 83 THEN PIECETYPE = SILVER
    IF PBT = 71 THEN PIECETYPE = GOLD
    IF PBT = 66 THEN PIECETYPE = BISHOP
    IF PBT = 82 THEN PIECETYPE = ROOK
END FUNCTION

FUNCTION FINDROW(FS$, FROW, FCNT)
    FINDROW = -1
    FL = LEN(FS$)
    IF FL < 4 THEN EXIT FUNCTION
    FF = PARSESQ(FS$, 0)
    FT = PARSESQ(FS$, 2)
    IF FF < 0 OR FT < 0 THEN EXIT FUNCTION
    FB = FF * 81 + FT
    FOR FI = 0 TO FCNT - 1
        FMV = MOVES(FROW, FI)
        FMATCH = 0
        IF FMV < DROP_FLAG THEN FBASE = FMV
        IF FMV < DROP_FLAG AND FMV >= PROMOTE_FLAG THEN FBASE = FMV - PROMOTE_FLAG
        IF FMV < DROP_FLAG AND FBASE = FB THEN FMATCH = -1
        IF FMATCH AND FL = 5 AND FMV >= PROMOTE_FLAG THEN FINDROW = FMV: EXIT FUNCTION
        IF FMATCH AND FL = 4 AND FMV < PROMOTE_FLAG THEN FINDROW = FMV: EXIT FUNCTION
        IF FMATCH AND FL = 4 AND FINDROW < 0 THEN FINDROW = FMV
    NEXT FI
END FUNCTION


' ---- 自己テスト（ホストでも走る） ----
SUB SELFTEST
    SETUP
    N = LEGAL(1, 1, 0, 0)
    PRINT "selftest: initial legal "; N; " (want 30)"
    NAMES$ = "7g7f,3c3d,2g2f,8c8d,"
    FOR STI2 = 1 TO 4
        N = LEGAL(TURN, 1, 0, 0)
        NAM$ = MID$(NAMES$, (STI2 - 1) * 5 + 1, 4)
        MV = FINDROW(NAM$, 0, N)
        IF MV < 0 THEN PRINT "selftest: "; NAM$; " not legal": EXIT SUB
        U = DOMOVE(MV)
    NEXT STI2
    N = LEGAL(TURN, 1, 0, 0)
    PRINT "selftest: after 4 moves turn="; TURN; " legal="; N
    HS0 = POSHASH()
    FOR STI3 = 0 TO N - 1
        U = DOMOVE(MOVES(0, STI3))
        HS1 = POSHASH()
        UNDOMOVE U
        HS2 = POSHASH()
        IF HS2 <> HS0 THEN PRINT "undo mismatch i="; STI3; " mv="; MOVES(0, STI3); " h0="; HS0; " h1="; HS1; " h2="; HS2: END
    NEXT STI3
    PRINT "selftest: single undo all ok"
    ENG_LIMIT = 2000: ENG_MAXDEPTH = 3
    HS0 = POSHASH()
    T0 = Machine.Ms
    MV = PICKMOVE()
    EL = Machine.Ms - T0
    HS1 = POSHASH()
    IF HS1 <> HS0 THEN PRINT "selftest: search changed the position"
    PRINT "selftest: ai "; USINAME(MV); " depth="; ENG_DEPTH; " nodes="; ENG_NODES; " score="; ENG_SCORE; " ms="; EL
    U = DOMOVE(MV)
    N = LEGAL(TURN, 1, 0, 0)
    PRINT "selftest: after ai legal="; N; " check="; -INCHECK(TURN)
    UNDOMOVE U
    PRINT "selftest: undo turn="; TURN
END SUB

