        Machine.TextPut 0, CNI, SPACE$(19), Machine.TAttr(0, 0, 0)
        Machine.TextPut 61, CNI, SPACE$(19), Machine.TAttr(0, 0, 0)
    NEXT CNI
    FOR CNI = 21 TO 27: CLEARROW CNI: NEXT CNI
END SUB

