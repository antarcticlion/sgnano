' sgnano test application in SG BASIC -- mode 1: text only. The text demo and the status rows.
' The BASIC version of samples/ruby/testapp/mode1.rb (the same screen and keys). The screen mode is set once here.
' The music: WTF4CH.mid (the sample SMF) in the same folder as this program, repeated (m pauses and resumes it).
' Generated by scripts/make_testapp_bas.py (2026-11-01); edit that script, not this file.
' Keys: m music pause, t text on/off. q ends it.
DEFDBL A-Z
Machine.Mode = 1
TA = Machine.TEXT_BG_TRANSPARENT

' ---- small helpers (BASIC has no format()) ----
FUNCTION DS(BYVAL V) AS STRING          ' an integer as text, no leading space
    DSX$ = STR$(INT(V))
    IF LEFT$(DSX$, 1) = " " THEN DSX$ = MID$(DSX$, 2)
    DS = DSX$
END FUNCTION
FUNCTION LJ(BYVAL S$, BYVAL N) AS STRING   ' "%-Ns"
    IF LEN(S$) < N THEN LJ = S$ + SPACE$(N - LEN(S$)) ELSE LJ = S$
END FUNCTION
FUNCTION RJ(BYVAL S$, BYVAL N) AS STRING   ' "%Ns"
    IF LEN(S$) < N THEN RJ = SPACE$(N - LEN(S$)) + S$ ELSE RJ = S$
END FUNCTION
FUNCTION SG(BYVAL V, BYVAL N) AS STRING    ' "%+Nd"
    SGX$ = DS(V)
    IF V >= 0 THEN SGX$ = "+" + SGX$
    SG = RJ(SGX$, N)
END FUNCTION
FUNCTION F2U(BYVAL V) AS STRING            ' "%.2f" of a value >= 0
    F2R = INT(V * 100 + 0.5)
    F2U = DS(INT(F2R / 100)) + "." + RIGHT$("0" + DS(F2R - INT(F2R / 100) * 100), 2)
END FUNCTION
FUNCTION F2(BYVAL V) AS STRING             ' "%+.2f"
    IF V < 0 THEN F2 = "-" + F2U(-V) ELSE F2 = "+" + F2U(V)
END FUNCTION
FUNCTION H4(BYVAL V) AS STRING             ' "%04X"
    H4 = RIGHT$("000" + HEX$(V), 4)
END FUNCTION
FUNCTION UC(BYVAL S$) AS STRING            ' upper case (ASCII)
    UCX$ = ""
    FOR UCI = 1 TO LEN(S$)
        UCC = ASC(MID$(S$, UCI, 1))
        IF UCC >= 97 AND UCC <= 122 THEN UCC = UCC - 32
        UCX$ = UCX$ + CHR$(UCC)
    NEXT UCI
    UC = UCX$
END FUNCTION
FUNCTION BIT(BYVAL V, BYVAL I)             ' bit I of a value that may be wider than 16 bits
    BIT = INT(V / 2 ^ I) - 2 * INT(V / 2 ^ (I + 1))
END FUNCTION
FUNCTION WRAP(BYVAL V, BYVAL N)            ' V mod N for any size of V (MOD and AND are 16-bit)
    WRAP = V - INT(V / N) * N
END FUNCTION
FUNCTION CLAMP(BYVAL V, BYVAL LO, BYVAL HI)
    IF V < LO THEN CLAMP = LO ELSE IF V > HI THEN CLAMP = HI ELSE CLAMP = V
END FUNCTION

' ---- text demo and status rows (src/app/status.c) ----
SUB TPUT(BYVAL ROW, BYVAL S$, BYVAL FG)    ' a row from column 2, padded to column 76
    Machine.TextPut 2, ROW, LJ(LEFT$(S$, 74), 74), Machine.TAttr(FG, 0, TA)
END SUB
SUB TEXTDEMO(BYVAL HELP$)
    Machine.TextClear Machine.TEXT_CLEAR    ' transparent: the graphics show through
    Machine.TextPut 2, 0, "sgnano  ABCabc012  ｱｲｳｴｵ  あいう漢字ＡＢＣ", Machine.TAttr(15, 0, TA)
    FOR TDI = 0 TO 15: Machine.TextPut 2 + TDI, 1, " ", Machine.TAttr(0, TDI): NEXT TDI
    Machine.TextPut 19, 1, LEFT$(HELP$, 59), Machine.TAttr(7, 0, TA)
END SUB
ROWVIDEO = 3: ROWFRAME = 4: ROWSYS = 5: ROWUSB = 6: ROWKBD = 8: ROWECHO = 9
ROWMOUSE = 10: ROWMSC = 12: ROWPAD = 16: ROWPADUI = 20
ECHO$ = "": KEYSN = 0
SUB STATUSVIDEO
    LH = Machine.VideoInfo("line_hz")
    TPUT ROWVIDEO, LJ(Machine.VideoInfo("timing"), 22) + " mode " + LJ(Machine.VideoInfo("mode_name"), 16) + " fb " + LJ(Machine.VideoInfo("fb"), 6) + " " + DS(INT(LH / 1000)) + "." + RIGHT$("00" + DS(LH - INT(LH / 1000) * 1000), 3) + "kHz " + F2U(Machine.VideoInfo("frame_hz")) + "Hz", 11
END SUB
SUB STATUSFRAME
    S$ = "f" + LJ(DS(Machine.VideoInfo("frames")), 8) + " ur" + LJ(DS(Machine.VideoInfo("underrun")), 5) + " st" + LJ(DS(Machine.VideoInfo("fifo_stall")), 5)
    S$ = S$ + " rc" + LJ(DS(Machine.VideoInfo("recover")), 3) + " lt" + DS(Machine.VideoInfo("late_start")) + "/" + DS(Machine.VideoInfo("late_render"))
    TPUT ROWFRAME, S$ + "  pair " + DS(Machine.VideoInfo("pair_max0")) + "/" + DS(Machine.VideoInfo("pair_max1")) + "us", 11
END SUB
SUB STATUSSYS
    TPUT ROWSYS, "up " + DS(Machine.SysInfo("uptime")) + "s  mem free " + DS(INT(Machine.SysInfo("mem_free") / 1024)) + "K (max " + DS(INT(Machine.SysInfo("mem_largest") / 1024)) + "K)  basic", 10
END SUB
SUB STATUSUSB
    TPUT ROWUSB, "usb dev " + DS(Machine.SysInfo("usb_devices")) + " hub " + DS(Machine.SysInfo("hubs")) + "  pad " + DS(Machine.SysInfo("pads")) + "  reinit " + DS(Machine.SysInfo("usb_reinit")) + " wedged " + DS(Machine.SysInfo("usb_wedged")), 10
END SUB
SUB STATUSKBD
    L = Machine.SysInfo("kbd_leds")
    IF Machine.SysInfo("keyboard") THEN S$ = "kbd ok  " ELSE S$ = "kbd --  "
    S$ = S$ + H4(Machine.SysInfo("kbd_vid")) + ":" + H4(Machine.SysInfo("kbd_pid")) + " n=" + LJ(DS(KEYSN), 5) + " led "
    IF L AND 1 THEN S$ = S$ + "N" ELSE S$ = S$ + "-"
    IF L AND 2 THEN S$ = S$ + "C" ELSE S$ = S$ + "-"
    IF L AND 4 THEN S$ = S$ + "S" ELSE S$ = S$ + "-"
    TPUT ROWKBD, S$, 14
    TPUT ROWECHO, ECHO$, 15
END SUB
SUB STATUSMOUSE
    B = Machine.Mouse("buttons")
    IF Machine.Mouse("connected") THEN S$ = "mouse ok  btn " ELSE S$ = "mouse --  btn "
    IF B AND 1 THEN S$ = S$ + "L" ELSE S$ = S$ + "-"
    IF B AND 4 THEN S$ = S$ + "M" ELSE S$ = S$ + "-"
    IF B AND 2 THEN S$ = S$ + "R" ELSE S$ = S$ + "-"
    TPUT ROWMOUSE, S$, 14
    TPUT ROWMOUSE + 1, "x " + SG(CLAMP(Machine.Mouse("x"), -999999, 999999), 7) + "  y " + SG(CLAMP(Machine.Mouse("y"), -999999, 999999), 7) + "  wheel " + SG(CLAMP(Machine.Mouse("wheel"), -999999, 999999), 5), 15
END SUB
SUB STATUSMSC(BYVAL K)
    IF Machine.Storage(K, "connected") THEN TPUT ROWMSC + K, "msc" + DS(K) + " " + Machine.Storage(K, "vendor") + " " + Machine.Storage(K, "product") + " " + DS(Machine.Storage(K, "mb")) + "MB", 10 ELSE TPUT ROWMSC + K, "msc" + DS(K) + " --", 10
END SUB
DIM AXN$(5)
AXN$(0) = "X": AXN$(1) = "Y": AXN$(2) = "Z": AXN$(3) = "Rx": AXN$(4) = "Ry": AXN$(5) = "Rz"
SUB STATUSPAD(BYVAL K)
    IF NOT Machine.Pad(K, "connected") THEN TPUT ROWPAD + K, "p" + DS(K) + " --", 14: EXIT SUB
    S$ = "p" + DS(K) + " " + H4(Machine.Pad(K, "vid")) + ":" + H4(Machine.Pad(K, "pid")) + " h" + DS(Machine.Pad(K, "hat"))
    FOR PAI = 0 TO 5: S$ = S$ + " " + AXN$(PAI) + SG(Machine.Pad(K, "axis" + DS(PAI)), 4): NEXT PAI
    N = Machine.Pad(K, "buttons_n")
    IF N > 20 THEN N = 20
    IF N > 0 THEN S$ = S$ + " "
    B = Machine.Pad(K, "buttons")
    FOR PBI = 0 TO N - 1
        IF BIT(B, PBI) THEN S$ = S$ + DS((PBI MOD 9) + 1) ELSE S$ = S$ + "."
    NEXT PBI
    TPUT ROWPAD + K, S$, 14
END SUB
SUB STATUSPADIF(BYVAL P, BYVAL K)       ' a pad row: when connected, or its turn to show "--"
    IF Machine.Pad(P, "connected") OR K = 7 + P THEN STATUSPAD P
END SUB
SLOW = 0
SUB STATUSTICK                          ' rows that change slowly: one a frame in turn; the frame, keyboard, mouse and pads every frame
    K = SLOW MOD 11
    SLOW = SLOW + 1
    IF SLOW >= 11000 THEN SLOW = 0
    IF K = 0 THEN STATUSVIDEO ELSE IF K = 1 THEN STATUSSYS ELSE IF K = 2 THEN STATUSUSB ELSE IF K < 7 THEN STATUSMSC K - 3
    STATUSFRAME
    STATUSKBD
    STATUSMOUSE
    IF Machine.SysInfo("pads") > 0 OR K >= 7 THEN FOR STP = 0 TO 3: STATUSPADIF STP, K: NEXT STP
END SUB
SUB KEYECHO(BYVAL C)                    ' the keys typed, at the bottom of the keyboard rows
    KEYSN = KEYSN + 1
    IF C >= 32 AND C < 127 THEN ECHO$ = ECHO$ + CHR$(C) ELSE ECHO$ = ECHO$ + "."
    IF LEN(ECHO$) > 60 THEN ECHO$ = RIGHT$(ECHO$, 60)
END SUB

' ---- the keys at the bottom of the screen ----
KEYROW = 21                             ' rows 21..27 (the status rows end at 19, the pad row is 20)
SUB KEYITEM(BYVAL I, BYVAL K$, BYVAL D$)
    KX = 2 + (I MOD 2) * 38: KY = KEYROW + 1 + INT(I / 2)
    Machine.TextPut KX, KY, RJ(K$, 7), Machine.TAttr(14, 0, TA)
    Machine.TextPut KX + 8, KY, LEFT$(D$, 29), Machine.TAttr(7, 0, TA)
END SUB

' ---- music (the sample SMF, Sound / SPEC_sound.md) ----
SUB MUSICSTART
    IF Sound.Play("WTF4CH.mid", -1) THEN PRINT "music: WTF4CH.mid ("; Sound.Length / 1000; "s, repeated; m pauses)" ELSE PRINT "music: WTF4CH.mid is not in this folder -- no music"
END SUB
SUB MUSICKEY(BYVAL C)
    IF C <> 109 OR NOT Sound.Playing THEN EXIT SUB    ' m
    IF Sound.Paused THEN Sound.Resume ELSE Sound.Pause
END SUB

' ---- the pad (pad 0): what is pressed now, for the screen ----
DIM PADN(15), PADS$(15)
DATA 1, X, 2, A, 3, B, 4, Y, 5, LB, 6, RB, 7, LT, 8, RT, 9, BACK, 10, START, 11, LS, 12, RS, 29, UP, 30, DOWN, 31, LEFT, 32, RIGHT
FOR I = 0 TO 15: READ PADN(I), PADS$(I): NEXT I
PADON = 0: PADCHK = 0
FUNCTION PADLINE(BYVAL SHORT) AS STRING
    PADCHK = PADCHK + 1
    IF PADCHK MOD 30 = 1 THEN PADON = Machine.Pad(0, "connected")   ' connected? (twice a second)
    IF PADCHK >= 30000 THEN PADCHK = 0
    IF NOT PADON THEN IF SHORT THEN PADLINE = "PAD --": EXIT FUNCTION ELSE PADLINE = "pad 0: not connected (the F310 needs the D switch)": EXIT FUNCTION
    HELD$ = ""
    FOR PI = 0 TO 11: IF Machine.PadButton(0, PADN(PI)) THEN HELD$ = HELD$ + " " + PADS$(PI)
    NEXT PI
    IF LEN(HELD$) > 0 THEN HELD$ = MID$(HELD$, 2)
    IF ODIV = 1 THEN SP$ = "1" ELSE SP$ = "1/" + DS(ODIV)
    DX = Machine.PadDirX(0): DY = Machine.PadDirY(0)
    IF SHORT THEN PADLINE = "PAD " + SG(DX, 0) + " " + SG(DY, 0) + " " + HELD$ + " V" + SP$: EXIT FUNCTION
    S$ = "pad 0: dir " + SG(DX, 0) + " " + SG(DY, 0) + "  left " + F2(Machine.PadStickX(0, "left")) + " " + F2(Machine.PadStickY(0, "left"))
    PADLINE = S$ + "  right " + F2(Machine.PadStickX(0, "right")) + " " + F2(Machine.PadStickY(0, "right")) + "  " + HELD$ + ""
END FUNCTION
SUB PADEVENTS                           ' mode 0: the presses and releases to the UART log
    IF NOT PADON THEN PADCHK = PADCHK + 1: IF PADCHK MOD 30 = 1 THEN PADON = Machine.Pad(0, "connected")
    IF PADCHK >= 30000 THEN PADCHK = 0
    IF NOT PADON THEN EXIT SUB
    FOR PI = 0 TO 15
        IF Machine.PadPressed(0, PADN(PI)) THEN PRINT "[testapp] pad 0 "; PADS$(PI); " pressed"
        IF Machine.PadReleased(0, PADN(PI)) THEN PRINT "[testapp] pad 0 "; PADS$(PI); " released"
    NEXT PI
END SUB

SUB ONKEY(BYVAL C)
    MUSICKEY C
    KEYECHO C
    IF C = 116 THEN Machine.TextVisible = NOT Machine.TextVisible   ' t
END SUB

' ---- main loop ----
MUSICSTART
Machine.TextVisible = -1
TEXTDEMO "m=music t=text q=quit"
FOR P = 0 TO 3: STATUSPAD P: NEXT P
FOR K = 0 TO 3: STATUSMSC K: NEXT K
Machine.TextPut 2, KEYROW, "-- keys " + STRING$(66, "-"), Machine.TAttr(8, 0, TA)
KEYITEM 0, "m", "music pause / resume"
KEYITEM 1, "t", "text plane on / off"
KEYITEM 2, "q", "quit"
QUIT = 0
WHILE NOT QUIT
    C = Machine.Key
    WHILE C >= 0 AND NOT QUIT
        IF C = 113 THEN QUIT = -1 ELSE ONKEY C
        C = Machine.Key
    WEND
    STATUSTICK
    TPUT ROWPADUI, PADLINE(0), 11
    Machine.VSync
WEND
Sound.Stop
PRINT "bye"
